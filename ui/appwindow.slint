import "./fonts/CaskaydiaCoveNF-SemiBold.ttf";
import "./fonts/CaskaydiaCoveNF-SemiBoldItalic.ttf";

// Re-export models for Rust bindings and external usage
export { FileItem, TokenItem, HighlightLineItem, LabelItem, SuggestionItem, DocItem, TerminalLineItem } from "./models.slint";

import { FileItem, TokenItem, HighlightLineItem, LabelItem, SuggestionItem, DocItem, TerminalLineItem } from "./models.slint";
import { Header } from "./components/header.slint";
import { Sidebar } from "./components/sidebar.slint";
import { TerminalPanel } from "./components/terminal_panel.slint";
import { FileDropdownMenu, RunDropdownMenu, ViewDropdownMenu, HelpDropdownMenu } from "./components/dropdown_menus.slint";
import { ExplorerContextMenu } from "./components/explorer_context_menu.slint";
import { EditorPage } from "./pages/editor_page.slint";
import { DocsPage } from "./pages/docs_page.slint";

export component AppWindow inherits Window {
    title: "ASMCode - Intel 8080 IDE";
    icon: @image-url("icons/app_8080.svg");
    preferred-width: 1600px;
    preferred-height: 1000px;
    min-width: 1200px;
    min-height: 800px;
    background: #181825;
    default-font-family: "CaskaydiaCove NF SemiBold";

    // Language setting: "ru" by default, "en" optional
    in-out property <string> current_language: "ru";

    // Dynamic Zoom & Font properties
    in-out property <length> editor_font_size: 18px;
    in-out property <bool> editor_font_italic: true;
    out property <length> editor_line_height: measure_text_2.preferred-height - measure_text_1.preferred-height;

    // Resizable Layout Dimensions
    in-out property <length> sidebar_width: 320px;
    in-out property <length> terminal_height: 180px;

    // Collapsible Sections & Panels
    in-out property <bool> labels_expanded: true;
    in-out property <bool> right_drawer_expanded: true;
    in-out property <bool> terminal_expanded: true;

    // Custom Context Menu States & Coordinates
    in-out property <bool> show_context_menu: false;
    in-out property <bool> show_editor_context_menu: false;
    in-out property <bool> show_explorer_context_menu: false;
    in-out property <length> context_menu_x: 100px;
    in-out property <length> context_menu_y: 100px;
    in-out property <length> explorer_menu_x: 100px;
    in-out property <length> explorer_menu_y: 100px;

    // Blinking Cursor Timer (530ms standard IDE blink rate)
    in-out property <bool> cursor_visible: true;
    Timer {
        interval: 530ms;
        running: true;
        triggered => {
            root.cursor_visible = !root.cursor_visible;
        }
    }

    measure_text_1 := Text {
        visible: false;
        font-family: "CaskaydiaCove NF SemiBold";
        font-size: root.editor_font_size;
        font-weight: 600;
        text: "Mg";
    }
    measure_text_2 := Text {
        visible: false;
        font-family: "CaskaydiaCove NF SemiBold";
        font-size: root.editor_font_size;
        font-weight: 600;
        text: "Mg\nMg";
    }

    // State properties
    in-out property <string> current_dir_path: "D:\\Rust\\asmcode";
    in-out property <string> active_file_name: "";
    in-out property <string> active_file_path: "";
    in-out property <bool> is_dirty: false;
    in-out property <bool> is_active_asm: true;
    in-out property <string> code_text: "";
    in-out property <string> line_numbers_text: "1\n2\n3";
    in-out property <bool> show_new_file_dialog: false;
    in-out property <bool> show_new_folder_dialog: false;
    in-out property <bool> show_rename_dialog: false;
    in-out property <string> rename_target_name: "";
    in-out property <string> selected_explorer_path: "";
    in-out property <string> selected_explorer_name: "";
    in-out property <string> status_message: "Ready";
    in-out property <color> status_color: #a6e3a1;
    in-out property <string> search_filter: "";
    in-out property <string> output_log_text: "[SYSTEM] ASMCode Intel 8080 IDE initialized.";
    in property <[TerminalLineItem]> terminal_lines: [];

    // Menu dropdown toggles
    in-out property <bool> show_file_menu: false;
    in-out property <bool> show_run_menu: false;
    in-out property <bool> show_view_menu: false;
    in-out property <bool> show_help_menu: false;

    // Autocomplete popup toggle & stationary anchor
    in-out property <bool> show_autocomplete_popup: false;
    in-out property <length> popup_anchor_x: 10px;
    in-out property <length> popup_anchor_y: 0px;
    in-out property <int> popup_trigger_line: -1;

    // Cursor tracking
    in-out property <length> cursor_x: 8px;
    in-out property <length> cursor_y: 0px;

    // View toggle: 0 = Unified Highlighted Editor, 2 = 8080 Opcode Encyclopedia
    in-out property <int> editor_mode: 0;

    // Models
    in property <[FileItem]> file_list: [];
    in property <[HighlightLineItem]> highlight_lines: [];
    in property <[LabelItem]> label_list: [];
    in property <[SuggestionItem]> suggestion_list: [];
    in property <[DocItem]> docs_list: [];

    // Selected suggestion details
    in-out property <string> selected_sugg_name: "MOV";
    in-out property <string> selected_sugg_category: "Пересылка данных";
    in-out property <string> selected_sugg_syntax: "MOV r1, r2";
    in-out property <string> selected_sugg_summary: "Копирование байта из регистра/памяти в другой регистр/память.";
    in-out property <string> selected_sugg_flags: "None";
    in-out property <string> selected_sugg_cycles: "5 (r,r) / 7 (r,M or M,r)";
    in-out property <string> selected_sugg_insert_text: "mov";
    in-out property <string> selected_sugg_icon_kind: "transfer";
    in-out property <string> selected_sugg_example: "mov a, b        ; Копировать B в A";

    // Callbacks
    callback file_clicked(string, bool);
    callback navigate_parent();
    callback refresh_files();
    callback create_file(string);
    callback create_new_folder(string);
    callback rename_file(string, string);
    callback delete_file_requested(string);
    callback copy_path_requested(string);
    callback reveal_in_explorer_requested(string);
    callback save_file();
    callback open_file_dialog();
    callback open_folder_dialog();
    callback run_assemble_only();
    callback run_emulator();
    callback run_syntax_check();
    callback clear_output();
    callback code_edited(string, int);
    callback insert_suggestion(string);
    callback select_suggestion(int);
    callback filter_changed(string);
    callback label_clicked(int);
    callback toggle_docs_mode();
    callback close_active_file();
    callback zoom_in();
    callback zoom_out();
    callback zoom_reset();
    callback toggle_language();
    callback trigger_autocomplete(int);
    callback apply_completion(string);
    callback apply_completion_at(string, int) -> int;
    callback insert_tab(int) -> int;
    callback insert_newline(int) -> int;
    callback delete_word_left(int) -> int;
    callback toggle_comment(int) -> int;
    callback toggle_comment_range(int, int) -> int;
    callback duplicate_line(int) -> int;
    callback editor_undo(int) -> int;
    callback editor_redo(int) -> int;
    callback navigate_suggestion(int);

    zoom_in => {
        if root.editor_font_size < 38px {
            root.editor_font_size += 2px;
        }
    }
    zoom_out => {
        if root.editor_font_size > 12px {
            root.editor_font_size -= 2px;
        }
    }
    zoom_reset => {
        root.editor_font_size = 18px;
    }

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        // Top Navigation Header
        Header {
            current_language: root.current_language;
            active_file_name: root.active_file_name;
            is_dirty: root.is_dirty;
            is_active_asm: root.is_active_asm;
            editor_mode: root.editor_mode;
            show_file_menu: root.show_file_menu;
            show_run_menu: root.show_run_menu;
            show_view_menu: root.show_view_menu;
            show_help_menu: root.show_help_menu;
            toggle_file_menu => {
                root.show_file_menu = !root.show_file_menu;
                root.show_run_menu = false;
                root.show_view_menu = false;
                root.show_help_menu = false;
            }
            toggle_run_menu => {
                root.show_run_menu = !root.show_run_menu;
                root.show_file_menu = false;
                root.show_view_menu = false;
                root.show_help_menu = false;
            }
            toggle_view_menu => {
                root.show_view_menu = !root.show_view_menu;
                root.show_file_menu = false;
                root.show_run_menu = false;
                root.show_help_menu = false;
            }
            toggle_help_menu => {
                root.show_help_menu = !root.show_help_menu;
                root.show_file_menu = false;
                root.show_run_menu = false;
                root.show_view_menu = false;
            }
            close_active_file => { root.close_active_file(); }
            toggle_docs_mode => { root.toggle_docs_mode(); }
            save_file => { root.save_file(); }
            run_syntax_check => { root.run_syntax_check(); }
            run_assemble_only => { root.run_assemble_only(); }
            run_emulator => { root.run_emulator(); }
        }

        Rectangle { height: 1px; background: #313244; }

        // Main Center Workspace (Sidebar + Central Page)
        HorizontalLayout {
            spacing: 0px;

            // Left Sidebar: File Explorer Tree & Labels
            Sidebar {
                sidebar_width: root.sidebar_width;
                current_language: root.current_language;
                current_dir_path: root.current_dir_path;
                active_file_path: root.active_file_path;
                file_list: root.file_list;
                label_list: root.label_list;
                labels_expanded <=> root.labels_expanded;
                show_new_file_dialog <=> root.show_new_file_dialog;
                show_new_folder_dialog <=> root.show_new_folder_dialog;
                show_rename_dialog <=> root.show_rename_dialog;
                rename_target_name: root.rename_target_name;
                selected_explorer_path: root.selected_explorer_path;
                navigate_parent => { root.navigate_parent(); }
                refresh_files => { root.refresh_files(); }
                create_file(text) => { root.create_file(text); }
                create_new_folder(text) => { root.create_new_folder(text); }
                rename_file(path, text) => { root.rename_file(path, text); }
                file_clicked(path, is_dir) => { root.file_clicked(path, is_dir); }
                file_right_clicked(path, name, mx, my) => {
                    root.selected_explorer_path = path;
                    root.selected_explorer_name = name;
                    root.explorer_menu_x = mx;
                    root.explorer_menu_y = my;
                    root.show_explorer_context_menu = true;
                }
                explorer_bg_right_clicked(mx, my) => {
                    root.selected_explorer_path = "";
                    root.selected_explorer_name = "";
                    root.explorer_menu_x = mx;
                    root.explorer_menu_y = my;
                    root.show_explorer_context_menu = true;
                }
                label_clicked(line_num) => { root.label_clicked(line_num); }
            }

            // Resizable Splitter Handle between Explorer and Central Area
            Rectangle {
                width: 5px;
                background: sidebar_resize_touch.has-hover ? #89b4fa : #313244;
                sidebar_resize_touch := TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        let new_w = root.sidebar_width + (self.mouse-x - self.pressed-x);
                        root.sidebar_width = max(180px, min(650px, new_w));
                    }
                }
            }

            // Central Area: Mode 0 (Editor) or Mode 2 (Docs)
            if root.editor_mode != 2: EditorPage {
                current_language: root.current_language;
                editor_font_size: root.editor_font_size;
                editor_font_italic: root.editor_font_italic;
                editor_line_height: root.editor_line_height;
                cursor_visible <=> root.cursor_visible;
                cursor_x <=> root.cursor_x;
                cursor_y <=> root.cursor_y;
                code_text <=> root.code_text;
                is_active_asm: root.is_active_asm;
                highlight_lines: root.highlight_lines;
                suggestion_list: root.suggestion_list;
                selected_sugg_name <=> root.selected_sugg_name;
                selected_sugg_category <=> root.selected_sugg_category;
                selected_sugg_syntax <=> root.selected_sugg_syntax;
                selected_sugg_summary <=> root.selected_sugg_summary;
                selected_sugg_flags <=> root.selected_sugg_flags;
                selected_sugg_cycles <=> root.selected_sugg_cycles;
                selected_sugg_insert_text <=> root.selected_sugg_insert_text;
                selected_sugg_icon_kind <=> root.selected_sugg_icon_kind;
                selected_sugg_example <=> root.selected_sugg_example;
                show_autocomplete_popup <=> root.show_autocomplete_popup;
                popup_anchor_x <=> root.popup_anchor_x;
                popup_anchor_y <=> root.popup_anchor_y;
                popup_trigger_line <=> root.popup_trigger_line;
                show_context_menu <=> root.show_context_menu;
                context_menu_x <=> root.context_menu_x;
                context_menu_y <=> root.context_menu_y;
                right_drawer_expanded <=> root.right_drawer_expanded;
                search_filter <=> root.search_filter;
                code_edited(t, o) => { root.code_edited(t, o); }
                editor_undo(o) => { return root.editor_undo(o); }
                editor_redo(o) => { return root.editor_redo(o); }
                delete_word_left(o) => { return root.delete_word_left(o); }
                toggle_comment_range(c, a) => { return root.toggle_comment_range(c, a); }
                duplicate_line(o) => { return root.duplicate_line(o); }
                insert_tab(o) => { return root.insert_tab(o); }
                insert_newline(o) => { return root.insert_newline(o); }
                apply_completion_at(s, o) => { return root.apply_completion_at(s, o); }
                apply_completion(s) => { root.apply_completion(s); }
                select_suggestion(idx) => { root.select_suggestion(idx); }
                trigger_autocomplete(o) => { root.trigger_autocomplete(o); }
                navigate_suggestion(d) => { root.navigate_suggestion(d); }
                save_file => { root.save_file(); }
                open_file_dialog => { root.open_file_dialog(); }
                run_emulator => { root.run_emulator(); }
                run_assemble_only => { root.run_assemble_only(); }
                zoom_in => { root.zoom_in(); }
                zoom_out => { root.zoom_out(); }
                zoom_reset => { root.zoom_reset(); }
                filter_changed(q) => { root.filter_changed(q); }
                insert_suggestion(s) => { root.insert_suggestion(s); }
            }

            if root.editor_mode == 2: DocsPage {
                current_language: root.current_language;
                docs_list: root.docs_list;
            }
        }

        // Resizable Splitter Handle above Terminal
        if root.terminal_expanded: Rectangle {
            height: 5px;
            background: term_split_touch.has-hover ? #89b4fa : #313244;
            term_split_touch := TouchArea {
                mouse-cursor: row-resize;
                moved => {
                    let new_h = root.terminal_height - (self.mouse-y - self.pressed-y);
                    root.terminal_height = max(70px, min(550px, new_h));
                }
            }
        }
        if !root.terminal_expanded: Rectangle { height: 1px; background: #313244; }

        // Bottom Panel: Output / Terminal Console
        TerminalPanel {
            current_language: root.current_language;
            terminal_expanded <=> root.terminal_expanded;
            terminal_height: root.terminal_height;
            status_message: root.status_message;
            status_color: root.status_color;
            output_log_text: root.output_log_text;
            terminal_lines: root.terminal_lines;
            clear_output => { root.clear_output(); }
        }
    }

    // Modal Backdrop: Closes top dropdown menus and explorer context menus when clicking outside
    if root.show_file_menu || root.show_run_menu || root.show_view_menu || root.show_help_menu || root.show_explorer_context_menu: TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        z: 95;
        clicked => {
            root.show_file_menu = false;
            root.show_run_menu = false;
            root.show_view_menu = false;
            root.show_help_menu = false;
            root.show_context_menu = false;
            root.show_editor_context_menu = false;
            root.show_explorer_context_menu = false;
        }
    }

    // Floating Dropdown Menus
    if root.show_file_menu: FileDropdownMenu {
        x: 80px;
        y: 58px;
        current_language: root.current_language;
        new_file => {
            root.show_file_menu = false;
            root.show_new_file_dialog = true;
        }
        open_file => {
            root.show_file_menu = false;
            root.open_file_dialog();
        }
        open_folder => {
            root.show_file_menu = false;
            root.open_folder_dialog();
        }
        save_file => {
            root.show_file_menu = false;
            root.save_file();
        }
        refresh_files => {
            root.show_file_menu = false;
            root.refresh_files();
        }
    }

    if root.show_run_menu: RunDropdownMenu {
        x: 148px;
        y: 58px;
        current_language: root.current_language;
        run_emulator => {
            root.show_run_menu = false;
            root.run_emulator();
        }
        run_assemble_only => {
            root.show_run_menu = false;
            root.run_assemble_only();
        }
        run_syntax_check => {
            root.show_run_menu = false;
            root.run_syntax_check();
        }
    }

    if root.show_view_menu: ViewDropdownMenu {
        x: 216px;
        y: 58px;
        current_language: root.current_language;
        editor_font_size: root.editor_font_size;
        editor_font_italic: root.editor_font_italic;
        zoom_in => { root.zoom_in(); }
        zoom_out => { root.zoom_out(); }
        zoom_reset => { root.zoom_reset(); }
        toggle_italic => { root.editor_font_italic = !root.editor_font_italic; }
        toggle_language => { root.toggle_language(); }
    }

    if root.show_help_menu: HelpDropdownMenu {
        x: 284px;
        y: 58px;
        current_language: root.current_language;
        open_docs => {
            root.show_help_menu = false;
            root.toggle_docs_mode();
        }
    }

    // Custom Stylized Explorer Context Menu
    if root.show_explorer_context_menu: ExplorerContextMenu {
        x: min(root.explorer_menu_x, root.width - 250px);
        y: min(root.explorer_menu_y, root.height - 280px);
        current_language: root.current_language;
        selected_explorer_path: root.selected_explorer_path;
        selected_explorer_name: root.selected_explorer_name;
        create_new_file => {
            root.show_explorer_context_menu = false;
            root.show_new_file_dialog = true;
        }
        create_new_folder => {
            root.show_explorer_context_menu = false;
            root.show_new_folder_dialog = true;
        }
        rename_requested => {
            root.show_explorer_context_menu = false;
            root.rename_target_name = root.selected_explorer_name;
            root.show_rename_dialog = true;
        }
        delete_requested(path) => {
            root.show_explorer_context_menu = false;
            root.delete_file_requested(path);
        }
        copy_path_requested(path) => {
            root.show_explorer_context_menu = false;
            root.copy_path_requested(path);
        }
        reveal_in_explorer_requested(path) => {
            root.show_explorer_context_menu = false;
            root.reveal_in_explorer_requested(path);
        }
        refresh_requested => {
            root.show_explorer_context_menu = false;
            root.refresh_files();
        }
    }
}
