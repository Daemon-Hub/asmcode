import { FileTabItem, HighlightLineItem, SuggestionItem, FindMatchItem, TextSelectionItem, BdosItem, AsciiItem } from "../models.slint";
import { TabBar } from "../components/tab_bar.slint";
import { RightDrawer } from "../components/right_drawer.slint";
import { AutocompletePopup } from "../components/autocomplete_popup.slint";
import { HoverPopup } from "../components/hover_popup.slint";
import { FindReplaceBar } from "../components/find_replace_bar.slint";
import { Theme } from "../components/theme.slint";
import { ScrollView } from "std-widgets.slint";

export component EditorPage inherits HorizontalLayout {
    in property <string> current_language: "ru";
    in property <length> editor_font_size: 18px;
    in property <bool> editor_font_italic: true;
    in property <length> editor_line_height: 24px;
    in property <length> char_advance: 9.8px;
    in-out property <bool> cursor_visible: true;
    in-out property <length> cursor_x: 8px;
    in-out property <length> cursor_y: 0px;
    in-out property <int> cursor_line: 0;

    // Find and Replace in Editor
    in-out property <bool> show_find_replace: false;
    in-out property <bool> show_replace_row: false;
    in-out property <string> find_text: "";
    in-out property <string> replace_text: "";
    in-out property <bool> find_match_case: false;
    in-out property <bool> find_whole_word: false;
    in property <int> find_match_count: 0;
    in property <int> find_match_index: 0;
    in property <[FindMatchItem]> find_matches: [];

    callback request_open_find(int, int, bool);
    callback editor_find(string, bool, bool);
    callback editor_find_next();
    callback editor_find_prev();
    callback editor_replace(string);
    callback editor_replace_all(string);
    callback move_lines_up(int, int) -> TextSelectionItem;
    callback move_lines_down(int, int) -> TextSelectionItem;
    callback duplicate_selection_or_line(int, int) -> TextSelectionItem;
    callback editor_focused();
    in property <bool> term_focused: false;
    in property <int> editor_focus_tick: 0;

    changed editor_focus_tick => {
        code_input.focus();
    }

    in property <int> select_range_start: -1;
    in property <int> select_range_end: -1;

    changed select_range_end => {
        if root.select_range_start >= 0 && root.select_range_end >= 0 {
            code_input.set-selection-offsets(root.select_range_start, root.select_range_end);
            code_input.focus();
            root.editor_focused();
        }
    }

    public function select_range(start: int, end: int) {
        code_input.set-selection-offsets(start, end);
        code_input.focus();
        root.editor_focused();
    }

    public function open_find() {
        root.show_find_replace = true;
        root.show_replace_row = false;
        root.editor_focused();
    }

    public function open_replace() {
        root.show_find_replace = true;
        root.show_replace_row = true;
        root.editor_focused();
    }

    // Tabs & Large File Support
    in property <[FileTabItem]> open_tabs: [];
    in property <string> active_file_path: "";
    in property <string> line_numbers_text: "";
    in property <bool> is_large_file_mode: false;
    in-out property <bool> show_tab_context_menu: false;
    in property <string> editor_ctx_action: "";
    in property <int> editor_ctx_action_tick: 0;
    in property <string> dnd_hover_target: "";
    in property <string> dnd_hover_filename: "";

    changed editor_ctx_action_tick => {
        if root.editor_ctx_action == "undo" {
            let new_pos = root.editor_undo(code_input.cursor-position-byte-offset);
            code_input.set-selection-offsets(new_pos, new_pos);
        } else if root.editor_ctx_action == "redo" {
            let new_pos = root.editor_redo(code_input.cursor-position-byte-offset);
            code_input.set-selection-offsets(new_pos, new_pos);
        } else if root.editor_ctx_action == "cut" {
            code_input.cut();
        } else if root.editor_ctx_action == "copy" {
            code_input.copy();
        } else if root.editor_ctx_action == "paste" {
            code_input.paste();
        } else if root.editor_ctx_action == "select_all" {
            code_input.select-all();
        } else if root.editor_ctx_action == "toggle_comment" {
            let new_pos = root.toggle_comment_range(code_input.cursor-position-byte-offset, code_input.anchor-position-byte-offset);
            code_input.set-selection-offsets(new_pos, new_pos);
        } else if root.editor_ctx_action == "duplicate_line" {
            let new_pos = root.duplicate_line(code_input.cursor-position-byte-offset);
            code_input.set-selection-offsets(new_pos, new_pos);
        }
        code_input.focus();
    }

    callback open_tab_context_menu(string, bool, length, length);
    callback open_editor_context_menu(length, length);

    callback file_dropped_in_editor(data-transfer);
    callback switch_tab(string);
    callback close_tab(string);
    callback close_other_tabs(string);
    callback close_saved_tabs();
    callback close_all_tabs();
    callback copy_relative_path(string);
    callback copy_absolute_path(string);
    callback reveal_in_explorer(string);
    callback show_in_explorer_tree(string);
    callback toggle_pin_tab(string);
    callback force_enable_large_file_features();
    callback close_all_context_menus();

    public function refresh_cursor() {
        code_input.set-selection-offsets(code_input.cursor-position-byte-offset, code_input.cursor-position-byte-offset);
    }

    in-out property <string> code_text <=> code_input.text;
    in property <bool> is_active_asm: true;
    in property <[HighlightLineItem]> highlight_lines: [];
    in property <int> highlight_start_line: 0;
    in property <int> gutter_start_line: 0;

    in-out property <int> visible_scroll_line: root.editor_line_height > 0px ? max(0, floor((-editor_scroll.content-y) / root.editor_line_height)) : 0;
    in-out property <int> visible_line_count: root.editor_line_height > 0px ? max(30, ceil(editor_scroll.visible-height / root.editor_line_height) + 10) : 30;

    changed visible_scroll_line => {
        root.show_hover_popup = false;
        root.editor_viewport_scrolled(self.visible_scroll_line, self.visible_line_count);
    }

    in property <[SuggestionItem]> suggestion_list: [];
    in property <[BdosItem]> bdos_list: [];
    in property <[AsciiItem]> ascii_list: [];
    in-out property <int> selected_sugg_index: 0;
    in-out property <string> selected_sugg_name: "MOV";
    in-out property <string> selected_sugg_category: "Пересылка данных";
    in-out property <string> selected_sugg_syntax: "MOV r1, r2";
    in-out property <string> selected_sugg_summary: "Копирование байта из регистра/памяти в другой регистр/память.";
    in-out property <string> selected_sugg_flags: "None";
    in-out property <string> selected_sugg_cycles: "5 (r,r) / 7 (r,M or M,r)";
    in-out property <string> selected_sugg_insert_text: "mov";
    in-out property <string> selected_sugg_icon_kind: "transfer";
    in-out property <string> selected_sugg_example: "mov a, b        ; Копировать B в A";

    in-out property <bool> show_autocomplete_popup: false;
    in-out property <length> popup_anchor_x: 10px;
    in-out property <length> popup_anchor_y: 0px;
    in-out property <int> popup_trigger_line: -1;

    // Hover Documentation Popup & Subtle Word Highlight
    in-out property <bool> show_hover_popup: false;
    in-out property <int> hover_word_line: 0;
    in-out property <int> hover_word_col: 0;
    in-out property <int> hover_word_len: 0;
    in-out property <string> hover_title: "";
    in-out property <string> hover_category: "";
    in-out property <string> hover_badge: "";
    in-out property <string> hover_syntax: "";
    in-out property <string> hover_flags: "";
    in-out property <string> hover_summary: "";
    in-out property <string> hover_kind: "transfer";
    in-out property <[HighlightLineItem]> hover_example_lines: [];
    in-out property <length> hover_mouse_x: -1px;
    in-out property <length> hover_mouse_y: -1px;
    in-out property <int> hover_probe_tick: 0;
    in-out property <int> hover_lookup_tick: 0;
    in-out property <bool> hover_popup_hovered: false;
    in-out property <bool> hover_on_same_target: false;
    callback request_hover_doc(int, int);

    changed show_hover_popup => {
        if !self.show_hover_popup {
            self.hover_popup_hovered = false;
            self.hover_on_same_target = false;
        }
    }

    changed hover_probe_tick => {
        if root.hover_popup_hovered {
            root.hover_on_same_target = true;
        } else {
            let local_x = root.hover_mouse_x - editor_viewport.absolute-position.x;
            let local_y = root.hover_mouse_y - editor_viewport.absolute-position.y;
            if local_x >= 0px && local_x < editor_scroll.visible-width && local_y >= 0px && local_y < editor_scroll.visible-height
                && root.char_advance > 0px && root.editor_line_height > 0px
            {
                let content_x = local_x - editor_scroll.content-x - 8px;
                let content_y = local_y - editor_scroll.content-y;
                if content_x >= 0px && content_y >= 0px {
                    let line = floor(content_y / root.editor_line_height);
                    let col = floor(content_x / root.char_advance);
                    root.hover_on_same_target = root.show_hover_popup
                        && line == root.hover_word_line
                        && col >= root.hover_word_col
                        && col < root.hover_word_col + root.hover_word_len;
                } else {
                    root.hover_on_same_target = false;
                }
            } else {
                root.hover_on_same_target = false;
            }
        }
    }

    changed hover_lookup_tick => {
        if !root.hover_popup_hovered {
            let local_x = root.hover_mouse_x - editor_viewport.absolute-position.x;
            let local_y = root.hover_mouse_y - editor_viewport.absolute-position.y;
            if local_x >= 0px && local_x < editor_scroll.visible-width && local_y >= 0px && local_y < editor_scroll.visible-height
                && root.char_advance > 0px && root.editor_line_height > 0px
            {
                let content_x = local_x - editor_scroll.content-x - 8px;
                let content_y = local_y - editor_scroll.content-y;
                if content_x >= 0px && content_y >= 0px {
                    let line = floor(content_y / root.editor_line_height);
                    let col = floor(content_x / root.char_advance);
                    root.request_hover_doc(line, col);
                } else {
                    root.show_hover_popup = false;
                }
            } else {
                root.show_hover_popup = false;
            }
        }
    }

    in-out property <bool> show_context_menu: false;
    in-out property <length> context_menu_x: 100px;
    in-out property <length> context_menu_y: 100px;

    in-out property <bool> right_drawer_expanded: true;
    in-out property <string> search_filter <=> drawer.search_filter;
    in-out property <int> active_theme_id: 1;
    in-out property <int> cursor_idle_ticks: 0;

    callback code_edited(string, int);
    callback editor_viewport_scrolled(int, int);
    callback editor_undo(int) -> int;
    callback editor_redo(int) -> int;
    callback delete_word_left(int) -> int;
    callback toggle_comment_range(int, int) -> int;
    callback duplicate_line(int) -> int;
    callback insert_tab(int, int) -> TextSelectionItem;
    callback unindent_lines(int, int) -> TextSelectionItem;
    callback insert_newline(int) -> int;
    callback apply_completion_at(string, int) -> int;
    callback apply_completion(string);
    callback select_suggestion(int);
    callback trigger_autocomplete(int);
    callback navigate_suggestion(int);
    callback save_file();
    callback save_file_as();
    callback open_file_dialog();
    callback run_emulator();
    callback run_assemble_only();
    callback zoom_in();
    callback zoom_out();
    callback zoom_reset();
    callback filter_changed(string);
    callback insert_suggestion(string);
    callback open_settings();

    spacing: 0px;

    // Central Editor Column (TabBar on top, Large File Banner, Code Area underneath)
    central_area := Rectangle {
        horizontal-stretch: 1;
        vertical-stretch: 1;

        // DropArea covering the editor area
        editor_drop := DropArea {
            width: 100%;
            height: 100%;
            can-drop(event) => { DragAction.copy }
            dropped(event) => {
                root.file_dropped_in_editor(event.data);
                return DragAction.copy;
            }
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;
            padding: 0px;

            // Open Tabs Bar (spanning between explorer and RightDrawer)
            if root.open_tabs.length > 0: TabBar {
                open_tabs: root.open_tabs;
                active_file_path: root.active_file_path;
                switch_tab(p) => {
                    root.switch_tab(p);
                    code_input.focus();
                    root.editor_focused();
                }
                close_tab(p) => { root.close_tab(p); }
                tab_context_menu(p, pinned, x, y) => {
                    root.open_tab_context_menu(p, pinned, x, y);
                }
            }

        // Large File Optimizations Toast / Banner
        if root.is_large_file_mode: Rectangle {
            height: 34px;
            background: Theme.bg_surface1;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border_normal;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/document.svg");
                            width: 14px;
                            height: 14px;
                        }
                    }
                    Text {
                        text: root.current_language == "ru"
                            ? "Режим больших файлов: подсветка синтаксиса и анализ кода отключены для повышения производительности"
                            : "Large file mode: syntax highlighting and code analysis disabled for performance";
                        font-size: 12px;
                        color: Theme.accent_yellow;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 170px;
                    height: 24px;
                    y: 5px;
                    border-radius: 3px;
                    background: force_btn.has-hover ? Theme.accent_blue : Theme.bg_surface2;

                    Text {
                        text: root.current_language == "ru" ? "Включить принудительно" : "Enable Anyway";
                        font-size: 11px;
                        font-weight: 700;
                        color: force_btn.has-hover ? #151518 : Theme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    force_btn := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.force_enable_large_file_features();
                        }
                    }
                }
            }
        }

        // Unified Code Viewport
        Rectangle {
            vertical-stretch: 1;
            background: Theme.editor_bg;

            HorizontalLayout {
                width: 100%;
                height: 100%;
                spacing: 0px;

                // Line Numbers Gutter: Virtualized & Synchronized Row-by-Row with Code Lines
                Rectangle {
                    width: root.gutter_start_line >= 9850 ? 78px : 62px;
                    background: Theme.gutter_bg;
                    clip: true;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                code_input.focus();
                                root.editor_focused();
                            }
                        }
                    }

                    Text {
                        x: 0px;
                        y: root.gutter_start_line * root.editor_line_height + editor_scroll.content-y;
                        width: parent.width - 10px;
                        text: root.line_numbers_text;
                        font-family: Theme.font_mono;
                        font-size: root.editor_font_size;
                        font-weight: 600;
                        color: Theme.line_number_color;
                        horizontal-alignment: right;
                    }
                }

                Rectangle { width: 1px; background: Theme.gutter_border; }

                // Main Editor Scrollable Area
                editor_viewport := Rectangle {
                    background: Theme.editor_bg;
                    clip: true;

                    editor_scroll := ScrollView {
                    content-width: max(self.visible-width, 1600px);
                    content-height: max(self.visible-height, code_input.preferred-height);

                    // Background Click & Right-Click Detector
                    editor_touch := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: parent.content-width;
                        height: parent.content-height;
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                code_input.focus();
                                root.editor_focused();
                            }
                            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                root.open_editor_context_menu(
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y
                                );
                            }
                        }
                    }

                    // Transparent TextInput (handles input, cursor navigation and selection background)
                    code_input := TextInput {
                        changed has-focus => {
                            if self.has-focus {
                                root.editor_focused();
                            }
                        }
                        x: 8px;
                        y: 0px;
                        width: parent.content-width - 8px;
                        height: max(parent.visible-height, self.preferred-height);
                        font-family: Theme.font_mono;
                        font-size: root.editor_font_size;
                        font-weight: 600;
                        font-italic: false;
                        color: (root.is_active_asm && root.highlight_lines.length > 0) ? #00000001 : Theme.text_primary;
                        wrap: no-wrap;
                        single-line: false;
                        text-cursor-width: 0px;
                        selection-background-color: Theme.selection_bg;
                        selection-foreground-color: (root.is_active_asm && root.highlight_lines.length > 0) ? #00000001 : #ffffff;

                        cursor-position-changed(cpos) => {
                            if root.term_focused {
                                root.editor_focused();
                            }
                            root.cursor_x = cpos.x + 8px;
                            root.cursor_y = cpos.y;
                            if root.editor_line_height > 0 {
                                root.cursor_line = round(cpos.y / root.editor_line_height);
                            }
                            root.cursor_visible = true;
                            root.cursor_idle_ticks = 0;

                            if (root.show_autocomplete_popup && root.popup_trigger_line >= 0) {
                                let diff = root.cursor_line - root.popup_trigger_line;
                                if (diff < 0 || diff > 0) {
                                    root.show_autocomplete_popup = false;
                                }
                            }
                        }

                        edited => {
                            if root.term_focused {
                                root.editor_focused();
                            }
                            root.show_hover_popup = false;
                            root.cursor_visible = true;
                            root.cursor_idle_ticks = 0;
                            root.code_edited(self.text, self.cursor-position-byte-offset);
                        }

                        key-pressed(e) => {
                            root.cursor_visible = true;
                            root.cursor_idle_ticks = 0;

                            // Escape: dismiss popups & find bar
                            if (e.text == Key.Escape) {
                                if root.show_hover_popup {
                                    root.show_hover_popup = false;
                                    return EventResult.accept;
                                }
                                if root.show_find_replace {
                                    root.show_find_replace = false;
                                    return EventResult.accept;
                                }
                                if root.show_context_menu {
                                    root.show_context_menu = false;
                                    return EventResult.accept;
                                }
                                if root.show_autocomplete_popup {
                                    root.show_autocomplete_popup = false;
                                    return EventResult.accept;
                                }
                            }

                            // Alt + UpArrow: Move selected line(s) up
                            if (e.modifiers.alt && (e.text == Key.UpArrow)) {
                                let res = root.move_lines_up(code_input.cursor-position-byte-offset, code_input.anchor-position-byte-offset);
                                code_input.set-selection-offsets(res.cursor-offset, res.anchor-offset);
                                return EventResult.accept;
                            }

                            // Alt + DownArrow: Move selected line(s) down
                            if (e.modifiers.alt && (e.text == Key.DownArrow)) {
                                let res = root.move_lines_down(code_input.cursor-position-byte-offset, code_input.anchor-position-byte-offset);
                                code_input.set-selection-offsets(res.cursor-offset, res.anchor-offset);
                                return EventResult.accept;
                            }

                            // Ctrl + Backspace: delete word left (handled before Ctrl+H)
                            if (e.modifiers.control && (e.text == Key.Backspace || e.text == "\u{007f}" || e.text == "\u{0008}")) {
                                let new_pos = root.delete_word_left(code_input.cursor-position-byte-offset);
                                code_input.set-selection-offsets(new_pos, new_pos);
                                return EventResult.accept;
                            }

                            // Ctrl + F: Open Find (Pre-populates with selection if active)
                            if (e.modifiers.control && (e.text == "f" || e.text == "F" || e.text == "а" || e.text == "А" || e.text == "\u{0006}")) {
                                let s = min(code_input.anchor-position-byte-offset, code_input.cursor-position-byte-offset);
                                let e_pos = max(code_input.anchor-position-byte-offset, code_input.cursor-position-byte-offset);
                                root.request_open_find(s, e_pos, false);
                                return EventResult.accept;
                            }

                            // Ctrl + R / Ctrl + H: Open Replace (Pre-populates with selection if active)
                            if (e.modifiers.control && (e.text == "r" || e.text == "R" || e.text == "к" || e.text == "К" || e.text == "\u{0012}" || e.text == "h" || e.text == "H" || e.text == "р" || e.text == "Р")) {
                                let s = min(code_input.anchor-position-byte-offset, code_input.cursor-position-byte-offset);
                                let e_pos = max(code_input.anchor-position-byte-offset, code_input.cursor-position-byte-offset);
                                root.request_open_find(s, e_pos, true);
                                return EventResult.accept;
                            }

                            // Autocomplete arrow navigation
                            if (root.show_autocomplete_popup && root.suggestion_list.length > 0) {
                                if (e.text == Key.UpArrow) {
                                    root.navigate_suggestion(-1);
                                    return EventResult.accept;
                                }
                                if (e.text == Key.DownArrow) {
                                    root.navigate_suggestion(1);
                                    return EventResult.accept;
                                }
                            }

                            // Ctrl + Space: trigger autocomplete
                            if (e.modifiers.control && (e.text == " " || e.text == Key.Space || e.text == "\u{0000}")) {
                                root.trigger_autocomplete(code_input.cursor-position-byte-offset);
                                return EventResult.accept;
                            }

                            // Ctrl + ,: Open Settings Modal
                            if (e.modifiers.control && (e.text == "," || e.text == "<" || e.text == "б" || e.text == "Б")) {
                                root.open_settings();
                                return EventResult.accept;
                            }

                            // Ctrl + Z: Undo
                            if (e.modifiers.control && !e.modifiers.shift && (e.text == "z" || e.text == "Z" || e.text == "я" || e.text == "Я" || e.text == "\u{001a}")) {
                                let new_pos = root.editor_undo(code_input.cursor-position-byte-offset);
                                code_input.set-selection-offsets(new_pos, new_pos);
                                return EventResult.accept;
                            }

                            // Ctrl + Y or Ctrl + Shift + Z: Redo
                            if ((e.modifiers.control && (e.text == "y" || e.text == "Y" || e.text == "н" || e.text == "Н" || e.text == "\u{0019}")) || (e.modifiers.control && e.modifiers.shift && (e.text == "z" || e.text == "Z" || e.text == "я" || e.text == "Я"))) {
                                let new_pos = root.editor_redo(code_input.cursor-position-byte-offset);
                                code_input.set-selection-offsets(new_pos, new_pos);
                                return EventResult.accept;
                            }

                            // Ctrl + /: Toggle line comment with ';'
                            if (e.modifiers.control && (e.text == "/" || e.text == "?" || e.text == "." || e.text == ",")) {
                                let new_pos = root.toggle_comment_range(code_input.cursor-position-byte-offset, code_input.anchor-position-byte-offset);
                                code_input.set-selection-offsets(new_pos, new_pos);
                                return EventResult.accept;
                            }

                            // Ctrl + D: Duplicate selected text (if selection active) or current line downwards with newline
                            if (e.modifiers.control && (e.text == "d" || e.text == "D" || e.text == "в" || e.text == "В" || e.text == "\u{0004}")) {
                                let res = root.duplicate_selection_or_line(code_input.cursor-position-byte-offset, code_input.anchor-position-byte-offset);
                                code_input.set-selection-offsets(res.cursor-offset, res.anchor-offset);
                                return EventResult.accept;
                            }

                            // Ctrl + A: Select All
                            if (e.modifiers.control && (e.text == "a" || e.text == "A" || e.text == "ф" || e.text == "Ф" || e.text == "\u{0001}")) {
                                code_input.select-all();
                                return EventResult.accept;
                            }

                            // Ctrl + C: Copy (support EN and RU keyboard layout)
                            if (e.modifiers.control && (e.text == "c" || e.text == "C" || e.text == "с" || e.text == "С" || e.text == "\u{0003}")) {
                                code_input.copy();
                                return EventResult.accept;
                            }

                            // Ctrl + V: Paste (support EN and RU keyboard layout)
                            if (e.modifiers.control && (e.text == "v" || e.text == "V" || e.text == "м" || e.text == "М" || e.text == "\u{0016}")) {
                                root.show_autocomplete_popup = false;
                                code_input.paste();
                                return EventResult.accept;
                            }

                            // Ctrl + X: Cut (support EN and RU keyboard layout)
                            if (e.modifiers.control && (e.text == "x" || e.text == "X" || e.text == "ч" || e.text == "Ч" || e.text == "\u{0018}")) {
                                code_input.cut();
                                return EventResult.accept;
                            }

                            // Ctrl + Shift + S: Save Copy As (creates a copy, leaves original file untouched)
                            if (e.modifiers.control && e.modifiers.shift && (e.text == "s" || e.text == "S" || e.text == "ы" || e.text == "Ы" || e.text == "\u{0013}")) {
                                root.save_file_as();
                                return EventResult.accept;
                            }

                            // Tab / Shift+Tab key
                            if (e.text == Key.Tab) {
                                if (!e.modifiers.shift && root.show_autocomplete_popup && root.suggestion_list.length > 0) {
                                    let new_pos = root.apply_completion_at(root.selected_sugg_insert_text, code_input.cursor-position-byte-offset);
                                    code_input.set-selection-offsets(new_pos, new_pos);
                                    root.show_autocomplete_popup = false;
                                } else if (e.modifiers.shift) {
                                    let res = root.unindent_lines(code_input.cursor-position-byte-offset, code_input.anchor-position-byte-offset);
                                    code_input.set-selection-offsets(res.anchor-offset, res.cursor-offset);
                                } else {
                                    let res = root.insert_tab(code_input.cursor-position-byte-offset, code_input.anchor-position-byte-offset);
                                    code_input.set-selection-offsets(res.anchor-offset, res.cursor-offset);
                                }
                                return EventResult.accept;
                            }

                            // Enter key
                            if (e.text == Key.Return) {
                                if root.show_autocomplete_popup && root.suggestion_list.length > 0 {
                                    let new_pos = root.apply_completion_at(root.selected_sugg_insert_text, code_input.cursor-position-byte-offset);
                                    code_input.set-selection-offsets(new_pos, new_pos);
                                    root.show_autocomplete_popup = false;
                                    return EventResult.accept;
                                }
                                let new_pos = root.insert_newline(code_input.cursor-position-byte-offset);
                                code_input.set-selection-offsets(new_pos, new_pos);
                                return EventResult.accept;
                            }

                            // Ctrl + S
                            if (e.modifiers.control && (e.text == "s" || e.text == "S" || e.text == "ы" || e.text == "Ы" || e.text == "\u{0013}")) {
                                root.save_file();
                                return EventResult.accept;
                            }

                            // Ctrl + O
                            if (e.modifiers.control && (e.text == "o" || e.text == "O" || e.text == "щ" || e.text == "Щ" || e.text == "\u{000f}")) {
                                root.open_file_dialog();
                                return EventResult.accept;
                            }

                            // F5: Run in emulator
                            if (e.text == Key.F5) {
                                root.run_emulator();
                                return EventResult.accept;
                            }

                            // Zoom controls
                            if (e.modifiers.control && (e.text == "+" || e.text == "=")) {
                                root.zoom_in();
                                code_input.set-selection-offsets(code_input.cursor-position-byte-offset, code_input.cursor-position-byte-offset);
                                return EventResult.accept;
                            }
                            if (e.modifiers.control && (e.text == "-" || e.text == "_")) {
                                root.zoom_out();
                                code_input.set-selection-offsets(code_input.cursor-position-byte-offset, code_input.cursor-position-byte-offset);
                                return EventResult.accept;
                            }
                            if (e.modifiers.control && e.text == "0") {
                                root.zoom_reset();
                                code_input.set-selection-offsets(code_input.cursor-position-byte-offset, code_input.cursor-position-byte-offset);
                                return EventResult.accept;
                            }

                            return EventResult.reject;
                        }
                    }

                    // Layer 2.4: Subtle Hovered Word Highlight (below syntax text, dimmer than selection)
                    if root.show_hover_popup && !root.show_autocomplete_popup && !root.show_context_menu && root.hover_word_len > 0: Rectangle {
                        x: 8px + root.hover_word_col * root.char_advance;
                        y: root.hover_word_line * root.editor_line_height;
                        width: max(root.hover_word_len * root.char_advance, 4px);
                        height: root.editor_line_height;
                        background: Theme.hover_highlight_bg;
                        border-radius: 2px;
                    }

                    // Layer 2.5: Find & Replace Match Highlights Layer
                    if root.show_find_replace && root.find_matches.length > 0: Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.content-width;
                        height: parent.content-height;

                        for match in root.find_matches: Rectangle {
                            x: 8px + match.char_offset * root.char_advance;
                            y: match.line_number * root.editor_line_height;
                            width: max(match.char_length * root.char_advance, 4px);
                            height: root.editor_line_height;
                            background: match.is_current ? #ffa71c88 : #7feef244;
                            border-width: match.is_current ? 1.5px : 1px;
                            border-color: match.is_current ? #ffa71c : #7feef288;
                            border-radius: 2px;
                        }
                    }

                    // Layer 3: Syntax-Highlighted Code Lines Layer (Rendered ON TOP OF selection background)
                    code_rows := VerticalLayout {
                        x: 0px;
                        y: root.highlight_start_line * root.editor_line_height;
                        padding: 0px;
                        padding-top: 0px;
                        padding-bottom: 0px;
                        alignment: start;
                        spacing: 0px;

                        for line in root.highlight_lines: HorizontalLayout {
                            alignment: start;
                            spacing: 0px;
                            padding: 0px;
                            padding-top: 0px;
                            padding-bottom: 0px;
                            height: root.editor_line_height;
                            padding-left: 8px;

                            if line.tokens.length == 0: Text {
                                text: " ";
                                font-family: Theme.font_mono;
                                font-size: root.editor_font_size;
                                font-weight: 600;
                                font-italic: false;
                                vertical-alignment: top;
                            }

                            for tok in line.tokens: Text {
                                text: tok.text;
                                color: tok.color;
                                font-family: Theme.font_mono;
                                font-size: root.editor_font_size;
                                font-weight: 600;
                                font-italic: tok.is_italic;
                                vertical-alignment: top;
                            }
                        }
                    }

                    // Layer 4: Vertical Blinking Caret (VS Code standard: strictly vertical, fixed 2px width, exact advance width, rendered on top)
                    if code_input.has-focus && !root.term_focused && root.cursor_visible: Rectangle {
                        x: root.cursor_x;
                        y: root.cursor_y;
                        width: 2px;
                        height: root.editor_line_height;
                        background: Theme.caret_color;
                    }

                    // In-Editor Floating Autocomplete Popup
                    if root.show_autocomplete_popup && root.suggestion_list.length > 0: AutocompletePopup {
                        x: min(max(10px, root.popup_anchor_x + 10px), max(10px, parent.width - 670px));
                        y: min(max(10px, root.popup_anchor_y + root.editor_line_height + 4px), max(10px, parent.height - 260px));
                        current_language: root.current_language;
                        suggestion_list: root.suggestion_list;
                        selected_sugg_index: root.selected_sugg_index;
                        selected_sugg_name: root.selected_sugg_name;
                        selected_sugg_category: root.selected_sugg_category;
                        selected_sugg_syntax: root.selected_sugg_syntax;
                        selected_sugg_summary: root.selected_sugg_summary;
                        selected_sugg_flags: root.selected_sugg_flags;
                        selected_sugg_cycles: root.selected_sugg_cycles;
                        selected_sugg_icon_kind: root.selected_sugg_icon_kind;
                        selected_sugg_example: root.selected_sugg_example;
                        select_suggestion(idx) => { root.select_suggestion(idx); }
                        apply_completion(text) => {
                            root.apply_completion(text);
                            root.show_autocomplete_popup = false;
                        }
                    }
                }

                // Floating VS Code-style Hover Documentation Card
                if root.show_hover_popup && !root.show_autocomplete_popup && !root.show_context_menu: hover_card := HoverPopup {
                    property <length> word_vp_x: 8px + root.hover_word_col * root.char_advance + editor_scroll.content-x;
                    property <length> word_vp_y: root.hover_word_line * root.editor_line_height + editor_scroll.content-y;
                    property <length> below_y: self.word_vp_y + root.editor_line_height + 2px;
                    property <length> above_y: self.word_vp_y - self.height - 2px;

                    x: min(max(8px, self.word_vp_x), max(8px, parent.width - self.width - 14px));
                    y: (self.below_y + self.height <= parent.height - 8px || self.above_y < 8px)
                        ? min(max(8px, self.below_y), max(8px, parent.height - self.height - 8px))
                        : self.above_y;
                    z: 90;
                    max_popup_width: min(500px, max(280px, parent.width - 24px));
                    current_language: root.current_language;
                    hover_title: root.hover_title;
                    hover_category: root.hover_category;
                    hover_badge: root.hover_badge;
                    hover_syntax: root.hover_syntax;
                    hover_flags: root.hover_flags;
                    hover_summary: root.hover_summary;
                    hover_kind: root.hover_kind;
                    hover_example_lines: root.hover_example_lines;
                    hovered_changed(h) => { root.hover_popup_hovered = h; }
                }

                // Floating Find & Replace Toolbar (VS Code standard, fixed in viewport top-right)
                if root.show_find_replace: find_bar := FindReplaceBar {
                    x: parent.width - self.width - 24px;
                    y: 10px;
                    z: 100;
                    current_language: root.current_language;
                    show_replace <=> root.show_replace_row;
                    find_text <=> root.find_text;
                    replace_text <=> root.replace_text;
                    match_case <=> root.find_match_case;
                    whole_word <=> root.find_whole_word;
                    match_count: root.find_match_count;
                    match_index: root.find_match_index;

                    find_changed(text, mc, ww) => {
                        root.editor_find(text, mc, ww);
                    }
                    find_next => {
                        root.editor_find_next();
                    }
                    find_prev => {
                        root.editor_find_prev();
                    }
                    replace_current(rep) => {
                        root.editor_replace(rep);
                    }
                    replace_all(rep) => {
                        root.editor_replace_all(rep);
                    }
                    focused => {
                        root.editor_focused();
                    }
                    close => {
                        root.show_find_replace = false;
                        code_input.focus();
                        root.editor_focused();
                    }
                }
            }
        }
    }
}

        // Visual Drag & Drop Overlay
        if editor_drop.has-drag || root.dnd_hover_target == "editor": Rectangle {
            width: 100%;
            height: 100%;
            background: #181825ee;
            border-width: 2px;
            border-color: Theme.accent_blue;
            border-radius: 6px;
            clip: true;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/document.svg");
                        width: 56px;
                        height: 56px;
                        colorize: Theme.accent_blue;
                    }
                }

                Text {
                    text: root.current_language == "ru"
                        ? "Отпустите файл для открытия в редакторе"
                        : "Drop file to open in editor";
                    font-size: 19px;
                    font-weight: 700;
                    color: Theme.text_primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.dnd_hover_filename != ""
                        ? root.dnd_hover_filename
                        : (root.current_language == "ru"
                            ? "Файл будет загружен в новую вкладку редактора"
                            : "File will open in a new editor tab");
                    font-size: 14px;
                    color: Theme.accent_green;
                    horizontal-alignment: center;
                }
            }
        }
    }

    Rectangle { width: 1px; background: #313244; }

    // Autocomplete / Intellisense Drawer
    drawer := RightDrawer {
        horizontal-stretch: 0;
        vertical-stretch: 1;
        current_language: root.current_language;
        right_drawer_expanded <=> root.right_drawer_expanded;
        suggestion_list: root.suggestion_list;
        bdos_list: root.bdos_list;
        ascii_list: root.ascii_list;
        selected_sugg_name: root.selected_sugg_name;
        selected_sugg_category: root.selected_sugg_category;
        selected_sugg_syntax: root.selected_sugg_syntax;
        selected_sugg_summary: root.selected_sugg_summary;
        selected_sugg_flags: root.selected_sugg_flags;
        selected_sugg_cycles: root.selected_sugg_cycles;
        selected_sugg_icon_kind: root.selected_sugg_icon_kind;
        selected_sugg_example: root.selected_sugg_example;
        filter_changed(q) => { root.filter_changed(q); }
        select_suggestion(idx) => { root.select_suggestion(idx); }
        insert_suggestion(syntax) => { root.insert_suggestion(syntax); }
    }
}
