import { DocItem } from "../models.slint";
import { ListView } from "std-widgets.slint";

export component DocsPage inherits VerticalLayout {
    in property <string> current_language: "ru";
    in property <[DocItem]> docs_list: [];

    padding: 16px;
    spacing: 12px;

    HorizontalLayout {
        alignment: space-between;
        Text {
            text: root.current_language == "ru"
                ? "ИНТЕРАКТИВНЫЙ СПРАВОЧНИК КОМАНД INTEL 8080"
                : "INTEL 8080 INSTRUCTION SET ENCYCLOPEDIA";
            font-size: 16px;
            font-weight: 700;
            color: #89b4fa;
        }
        Text {
            text: root.current_language == "ru" ? "Всего команд: 60" : "Total entries: 60 instructions";
            font-size: 14px;
            color: #a6adc8;
        }
    }

    ListView {
        vertical-stretch: 1;
        for doc in root.docs_list: Rectangle {
            height: 72px;

            Rectangle {
                x: 0px;
                y: 4px;
                width: parent.width;
                height: 64px;
                background: #181825;
                border-radius: 5px;
                border-width: 1px;
                border-color: #313244;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 14px;

                    VerticalLayout {
                        width: 130px;
                        alignment: center;
                        Text {
                            text: doc.name;
                            font-size: 17px;
                            font-weight: 700;
                            color: #61afef;
                        }
                        Text {
                            text: doc.category;
                            font-size: 12px;
                            color: #a6adc8;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: doc.syntax;
                            font-family: "CaskaydiaCove NF SemiBold";
                            font-size: 14px;
                            color: #a6e3a1;
                        }
                        Text {
                            text: doc.summary;
                            font-size: 13px;
                            color: #cdd6f4;
                            overflow: elide;
                        }
                    }

                    Rectangle { }

                    VerticalLayout {
                        width: 170px;
                        alignment: center;
                        Text {
                            text: (root.current_language == "ru" ? "Флаги: " : "Flags: ") + doc.flags;
                            font-size: 12px;
                            color: #f9e2af;
                        }
                        Text {
                            text: (root.current_language == "ru" ? "Такты: " : "Cycles: ") + doc.cycles + " | " + doc.bytes + " Б";
                            font-size: 12px;
                            color: #cdd6f4;
                        }
                    }
                }
            }
        }
    }
}
