import {
    DocItem, BdosItem, FcbFieldItem, BufferFieldItem, MemoryMapItem, RegisterItem,
    FlagItem, FlagRuleItem, AsciiItem, JumpConditionItem, CodePatternItem
} from "../models.slint";
import { Theme } from "../components/theme.slint";
import { ListView } from "std-widgets.slint";
import { BdosView } from "../components/docs/bdos_view.slint";
import { MemoryMapView } from "../components/docs/memory_map_view.slint";
import { RegistersView } from "../components/docs/registers_view.slint";
import { AsciiView } from "../components/docs/ascii_view.slint";
import { JumpsView } from "../components/docs/jumps_view.slint";

export component DocsPage inherits VerticalLayout {
    in property <string> current_language: "ru";
    in-out property <int> docs_active_module: 0; // 0=Instructions, 1=BDOS, 2=MemoryMap, 3=Registers/PSW, 4=ASCII, 5=Flags/Jumps
    in property <[DocItem]> docs_list: [];
    in property <int> docs_total_count: 85;
    in-out property <string> selected_category: root.current_language == "ru" ? "Все" : "All";
    in-out property <string> bdos_selected_category: root.current_language == "ru" ? "Все" : "All";
    in-out property <string> expanded_cmd: "";

    in property <[BdosItem]> bdos_list: [];
    in property <int> bdos_total_count: 37;
    in property <[FcbFieldItem]> fcb_fields_list: [];
    in property <[BufferFieldItem]> buffer_fields_list: [];
    in property <[MemoryMapItem]> memory_map_list: [];
    in property <[RegisterItem]> registers_list: [];
    in property <[FlagItem]> flags_list: [];
    in property <[FlagRuleItem]> flag_rules_list: [];
    in property <[AsciiItem]> ascii_list: [];
    in property <[JumpConditionItem]> jumps_list: [];
    in property <[CodePatternItem]> patterns_list: [];

    in-out property <string> docs_search_query: "";

    callback filter_category(string);
    callback filter_bdos_category(string);
    callback search_docs(string);
    callback insert_snippet(string);
    callback copy_text_to_clipboard(string);

    padding: 16px;
    spacing: 12px;

    // Top Educational Module Navigation Tabs
    Rectangle {
        height: 44px;
        background: Theme.terminal_bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border_normal;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 6px;
            alignment: start;

            // Module 0: 8080 Instructions
            Rectangle {
                width: root.current_language == "ru" ? 180px : 160px;
                height: 34px;
                border-radius: 4px;
                background: root.docs_active_module == 0 ? Theme.accent_blue : (m0.has-hover ? Theme.bg_surface2 : #00000000);
                m0 := TouchArea { mouse-cursor: pointer; clicked => { root.docs_active_module = 0; } }
                Text {
                    text: root.docs_search_query != ""
                        ? ((root.current_language == "ru" ? "Мнемоники (" : "Mnemonics (") + root.docs_list.length + ")")
                        : ((root.current_language == "ru" ? "Мнемоники 8080 (" : "8080 Instructions (") + root.docs_total_count + ")");
                    font-size: 13px;
                    font-weight: root.docs_active_module == 0 ? 600 : 500;
                    color: root.docs_active_module == 0 ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Module 1: BDOS System Calls
            Rectangle {
                width: root.current_language == "ru" ? 190px : 160px;
                height: 34px;
                border-radius: 4px;
                background: root.docs_active_module == 1 ? Theme.accent_blue : (m1.has-hover ? Theme.bg_surface2 : #00000000);
                m1 := TouchArea { mouse-cursor: pointer; clicked => { root.docs_active_module = 1; } }
                Text {
                    text: root.docs_search_query != ""
                        ? ((root.current_language == "ru" ? "Вызовы BDOS (" : "BDOS Calls (") + root.bdos_list.length + ")")
                        : (root.current_language == "ru" ? "Вызовы BDOS 2.2 (37)" : "BDOS 2.2 Calls (37)");
                    font-size: 13px;
                    font-weight: root.docs_active_module == 1 ? 600 : 500;
                    color: root.docs_active_module == 1 ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Module 2: Memory Map
            Rectangle {
                width: root.current_language == "ru" ? 170px : 150px;
                height: 34px;
                border-radius: 4px;
                background: root.docs_active_module == 2 ? Theme.accent_blue : (m2.has-hover ? Theme.bg_surface2 : #00000000);
                m2 := TouchArea { mouse-cursor: pointer; clicked => { root.docs_active_module = 2; } }
                Text {
                    text: root.docs_search_query != ""
                        ? ((root.current_language == "ru" ? "Карта памяти (" : "Memory Map (") + root.memory_map_list.length + ")")
                        : (root.current_language == "ru" ? "Карта памяти 64K" : "64K Memory Map");
                    font-size: 13px;
                    font-weight: root.docs_active_module == 2 ? 600 : 500;
                    color: root.docs_active_module == 2 ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Module 3: Registers & PSW
            Rectangle {
                width: root.current_language == "ru" ? 170px : 150px;
                height: 34px;
                border-radius: 4px;
                background: root.docs_active_module == 3 ? Theme.accent_blue : (m3.has-hover ? Theme.bg_surface2 : #00000000);
                m3 := TouchArea { mouse-cursor: pointer; clicked => { root.docs_active_module = 3; } }
                Text {
                    text: root.docs_search_query != ""
                        ? ((root.current_language == "ru" ? "Регистры / PSW (" : "Registers / PSW (") + (root.registers_list.length + root.flag_rules_list.length) + ")")
                        : (root.current_language == "ru" ? "Регистры и PSW" : "Registers & PSW");
                    font-size: 13px;
                    font-weight: root.docs_active_module == 3 ? 600 : 500;
                    color: root.docs_active_module == 3 ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Module 4: ASCII Table
            Rectangle {
                width: root.current_language == "ru" ? 170px : 150px;
                height: 34px;
                border-radius: 4px;
                background: root.docs_active_module == 4 ? Theme.accent_blue : (m4.has-hover ? Theme.bg_surface2 : #00000000);
                m4 := TouchArea { mouse-cursor: pointer; clicked => { root.docs_active_module = 4; } }
                Text {
                    text: root.docs_search_query != ""
                        ? ((root.current_language == "ru" ? "Таблица ASCII (" : "ASCII Table (") + root.ascii_list.length + ")")
                        : (root.current_language == "ru" ? "Таблица ASCII (128)" : "ASCII Table (128)");
                    font-size: 13px;
                    font-weight: root.docs_active_module == 4 ? 600 : 500;
                    color: root.docs_active_module == 4 ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Module 5: Conditional Jumps & Idioms
            Rectangle {
                width: root.current_language == "ru" ? 180px : 160px;
                height: 34px;
                border-radius: 4px;
                background: root.docs_active_module == 5 ? Theme.accent_blue : (m5.has-hover ? Theme.bg_surface2 : #00000000);
                m5 := TouchArea { mouse-cursor: pointer; clicked => { root.docs_active_module = 5; } }
                Text {
                    text: root.docs_search_query != ""
                        ? ((root.current_language == "ru" ? "Переходы (" : "Jumps (") + root.jumps_list.length + ")")
                        : (root.current_language == "ru" ? "Условные переходы" : "Flags & Jumps");
                    font-size: 13px;
                    font-weight: root.docs_active_module == 5 ? 600 : 500;
                    color: root.docs_active_module == 5 ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // MODULE 0: OPCODES LIST
    if root.docs_active_module == 0: VerticalLayout {
        spacing: 12px;

        // Header Title and Counter
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: root.current_language == "ru"
                    ? "ИНТЕРАКТИВНЫЙ СПРАВОЧНИК КОМАНД INTEL 8080"
                    : "INTEL 8080 INSTRUCTION SET ENCYCLOPEDIA";
                font-size: 18px;
                font-weight: 700;
                color: Theme.accent_blue;
                vertical-alignment: center;
            }
            Text {
                text: (root.current_language == "ru" ? "Показано команд: " : "Showing: ")
                    + root.docs_list.length
                    + (root.current_language == "ru" ? " из " : " of ")
                    + root.docs_total_count;
                font-size: 14px;
                color: Theme.text_muted;
                vertical-alignment: center;
            }
        }

    // Category Filter Bar
    Rectangle {
        height: 42px;
        background: Theme.terminal_bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border_normal;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 6px;
            alignment: start;

            // 0. All / Все
            Rectangle {
                width: 54px;
                height: 32px;
                border-radius: 4px;
                background: (root.selected_category == "Все" || root.selected_category == "All") ? Theme.accent_blue : (c0.has-hover ? Theme.bg_surface2 : #00000000);
                c0 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_category = root.current_language == "ru" ? "Все" : "All";
                        root.filter_category(root.selected_category);
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Все" : "All";
                    font-size: 13px;
                    font-weight: (root.selected_category == "Все" || root.selected_category == "All") ? 700 : 500;
                    color: (root.selected_category == "Все" || root.selected_category == "All") ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 1. Data Transfer / Пересылка
            Rectangle {
                width: root.current_language == "ru" ? 144px : 106px;
                height: 32px;
                border-radius: 4px;
                background: (root.selected_category == "Пересылка данных" || root.selected_category == "Data Transfer") ? Theme.accent_blue : (c1.has-hover ? Theme.bg_surface2 : #00000000);
                c1 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_category = root.current_language == "ru" ? "Пересылка данных" : "Data Transfer";
                        root.filter_category(root.selected_category);
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Пересылка данных" : "Data Transfer";
                    font-size: 13px;
                    font-weight: (root.selected_category == "Пересылка данных" || root.selected_category == "Data Transfer") ? 700 : 500;
                    color: (root.selected_category == "Пересылка данных" || root.selected_category == "Data Transfer") ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 2. Arithmetic / Арифметика
            Rectangle {
                width: root.current_language == "ru" ? 102px : 90px;
                height: 32px;
                border-radius: 4px;
                background: (root.selected_category == "Арифметика" || root.selected_category == "Arithmetic") ? Theme.accent_blue : (c2.has-hover ? Theme.bg_surface2 : #00000000);
                c2 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_category = root.current_language == "ru" ? "Арифметика" : "Arithmetic";
                        root.filter_category(root.selected_category);
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Арифметика" : "Arithmetic";
                    font-size: 13px;
                    font-weight: (root.selected_category == "Арифметика" || root.selected_category == "Arithmetic") ? 700 : 500;
                    color: (root.selected_category == "Арифметика" || root.selected_category == "Arithmetic") ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 3. Logical / Логика
            Rectangle {
                width: root.current_language == "ru" ? 154px : 76px;
                height: 32px;
                border-radius: 4px;
                background: (root.selected_category == "Логические операции" || root.selected_category == "Logical") ? Theme.accent_blue : (c3.has-hover ? Theme.bg_surface2 : #00000000);
                c3 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_category = root.current_language == "ru" ? "Логические операции" : "Logical";
                        root.filter_category(root.selected_category);
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Логические операции" : "Logical";
                    font-size: 13px;
                    font-weight: (root.selected_category == "Логические операции" || root.selected_category == "Logical") ? 700 : 500;
                    color: (root.selected_category == "Логические операции" || root.selected_category == "Logical") ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 4. Rotate / Сдвиги
            Rectangle {
                width: root.current_language == "ru" ? 74px : 70px;
                height: 32px;
                border-radius: 4px;
                background: (root.selected_category == "Сдвиги" || root.selected_category == "Rotate") ? Theme.accent_blue : (c4.has-hover ? Theme.bg_surface2 : #00000000);
                c4 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_category = root.current_language == "ru" ? "Сдвиги" : "Rotate";
                        root.filter_category(root.selected_category);
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Сдвиги" : "Rotate";
                    font-size: 13px;
                    font-weight: (root.selected_category == "Сдвиги" || root.selected_category == "Rotate") ? 700 : 500;
                    color: (root.selected_category == "Сдвиги" || root.selected_category == "Rotate") ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 5. Branch / Переходы
            Rectangle {
                width: root.current_language == "ru" ? 90px : 70px;
                height: 32px;
                border-radius: 4px;
                background: (root.selected_category == "Переходы" || root.selected_category == "Branch") ? Theme.accent_blue : (c5.has-hover ? Theme.bg_surface2 : #00000000);
                c5 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_category = root.current_language == "ru" ? "Переходы" : "Branch";
                        root.filter_category(root.selected_category);
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Переходы" : "Branch";
                    font-size: 13px;
                    font-weight: (root.selected_category == "Переходы" || root.selected_category == "Branch") ? 700 : 500;
                    color: (root.selected_category == "Переходы" || root.selected_category == "Branch") ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 6. Stack / Стек
            Rectangle {
                width: 62px;
                height: 32px;
                border-radius: 4px;
                background: (root.selected_category == "Стек" || root.selected_category == "Stack") ? Theme.accent_blue : (c6.has-hover ? Theme.bg_surface2 : #00000000);
                c6 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_category = root.current_language == "ru" ? "Стек" : "Stack";
                        root.filter_category(root.selected_category);
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Стек" : "Stack";
                    font-size: 13px;
                    font-weight: (root.selected_category == "Стек" || root.selected_category == "Stack") ? 700 : 500;
                    color: (root.selected_category == "Стек" || root.selected_category == "Stack") ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 7. I/O / Ввод-вывод
            Rectangle {
                width: root.current_language == "ru" ? 104px : 54px;
                height: 32px;
                border-radius: 4px;
                background: (root.selected_category == "Ввод-вывод" || root.selected_category == "I/O") ? Theme.accent_blue : (c7.has-hover ? Theme.bg_surface2 : #00000000);
                c7 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_category = root.current_language == "ru" ? "Ввод-вывод" : "I/O";
                        root.filter_category(root.selected_category);
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Ввод-вывод" : "I/O";
                    font-size: 13px;
                    font-weight: (root.selected_category == "Ввод-вывод" || root.selected_category == "I/O") ? 700 : 500;
                    color: (root.selected_category == "Ввод-вывод" || root.selected_category == "I/O") ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 8. Control / Управление
            Rectangle {
                width: root.current_language == "ru" ? 172px : 72px;
                height: 32px;
                border-radius: 4px;
                background: (root.selected_category == "Управление процессором" || root.selected_category == "Control") ? Theme.accent_blue : (c8.has-hover ? Theme.bg_surface2 : #00000000);
                c8 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_category = root.current_language == "ru" ? "Управление процессором" : "Control";
                        root.filter_category(root.selected_category);
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Управление процессором" : "Control";
                    font-size: 13px;
                    font-weight: (root.selected_category == "Управление процессором" || root.selected_category == "Control") ? 700 : 500;
                    color: (root.selected_category == "Управление процессором" || root.selected_category == "Control") ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 9. Directives / Директивы
            Rectangle {
                width: root.current_language == "ru" ? 166px : 86px;
                height: 32px;
                border-radius: 4px;
                background: (root.selected_category == "Директивы ассемблера" || root.selected_category == "Directives") ? Theme.accent_blue : (c9.has-hover ? Theme.bg_surface2 : #00000000);
                c9 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_category = root.current_language == "ru" ? "Директивы ассемблера" : "Directives";
                        root.filter_category(root.selected_category);
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Директивы ассемблера" : "Directives";
                    font-size: 13px;
                    font-weight: (root.selected_category == "Директивы ассемблера" || root.selected_category == "Directives") ? 700 : 500;
                    color: (root.selected_category == "Директивы ассемблера" || root.selected_category == "Directives") ? #151518 : Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Command Cards List
    ListView {
        vertical-stretch: 1;
        for doc in root.docs_list: Rectangle {
            height: root.expanded_cmd == doc.name ? (540px + doc.example_lines.length * 27px) : 68px;
            animate height { duration: 180ms; easing: ease-out; }

            Rectangle {
                x: 0px;
                y: 3px;
                width: parent.width;
                height: parent.height - 6px;
                background: card_touch.has-hover ? Theme.menu_hover : Theme.sidebar_bg;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.expanded_cmd == doc.name ? Theme.accent_blue : Theme.border_normal;
                clip: true;

                // Card Toggle TouchArea (Only active on the top header region)
                card_touch := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 52px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.expanded_cmd = (root.expanded_cmd == doc.name ? "" : doc.name);
                    }
                }

                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    padding-bottom: 20px;
                    spacing: 12px;

                    // Header Row (Always visible)
                    HorizontalLayout {
                        height: 40px;
                        spacing: 14px;

                        // Category Icon
                        VerticalLayout {
                            alignment: center;
                            width: 26px;
                            if doc.icon_kind == "transfer": Image { source: @image-url("../icons/grp_transfer.svg"); width: 24px; height: 24px; }
                            if doc.icon_kind == "arith": Image { source: @image-url("../icons/grp_arith.svg"); width: 24px; height: 24px; }
                            if doc.icon_kind == "logic": Image { source: @image-url("../icons/grp_logic.svg"); width: 24px; height: 24px; }
                            if doc.icon_kind == "branch": Image { source: @image-url("../icons/grp_branch.svg"); width: 24px; height: 24px; }
                            if doc.icon_kind == "stack": Image { source: @image-url("../icons/grp_stack.svg"); width: 24px; height: 24px; }
                            if doc.icon_kind == "directive": Image { source: @image-url("../icons/grp_directive.svg"); width: 24px; height: 24px; }
                        }

                        // Name and Category Label
                        VerticalLayout {
                            width: 150px;
                            alignment: center;
                            Text {
                                text: doc.name;
                                font-family: "CaskaydiaCove Nerd Font Propo";
                                font-size: 20px;
                                font-weight: 700;
                                color: Theme.accent_blue;
                            }
                            Text {
                                text: doc.category;
                                font-size: 13px;
                                color: Theme.text_muted;
                            }
                        }

                        // Preview Syntax & Short Summary (Visible ONLY when collapsed!)
                        if root.expanded_cmd != doc.name: VerticalLayout {
                            alignment: center;
                            Text {
                                text: doc.syntax;
                                font-family: "CaskaydiaCove Nerd Font Propo";
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.accent_green;
                            }
                            Text {
                                text: doc.summary;
                                font-size: 13px;
                                color: Theme.text_primary;
                                overflow: elide;
                            }
                        }

                        Rectangle { }

                        // Meta Badges: Flags & Cycles
                        VerticalLayout {
                            width: 210px;
                            alignment: center;
                            Text {
                                text: (root.current_language == "ru" ? "Флаги: " : "Flags: ") + doc.flags;
                                font-size: 13px;
                                color: Theme.accent_yellow;
                                horizontal-alignment: right;
                            }
                            Text {
                                text: (root.current_language == "ru" ? "Такты: " : "Cycles: ") + doc.cycles + " | " + doc.bytes + " Б";
                                font-size: 13px;
                                color: Theme.text_muted;
                                horizontal-alignment: right;
                            }
                        }

                        // Expand/Collapse Chevron Indicator
                        VerticalLayout {
                            alignment: center;
                            width: 26px;
                            Text {
                                text: root.expanded_cmd == doc.name ? "▲" : "▼";
                                font-size: 14px;
                                color: root.expanded_cmd == doc.name ? Theme.accent_blue : Theme.text_muted;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Expanded Comprehensive Encyclopedia Section
                    if root.expanded_cmd == doc.name: VerticalLayout {
                        spacing: 12px;

                        // Divider
                        Rectangle {
                            height: 1px;
                            background: Theme.border_normal;
                        }

                        // Syntax Format Block inside expanded card
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Text {
                                text: root.current_language == "ru" ? "Формат команды:" : "Command Syntax:";
                                font-size: 15px;
                                font-weight: 700;
                                color: Theme.text_muted;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                height: 32px;
                                background: Theme.bg_dark;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.border_light;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: doc.syntax;
                                        font-family: "CaskaydiaCove Nerd Font Propo";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: Theme.accent_green;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Section 1: Detailed Mechanics & Description
                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: root.current_language == "ru" ? "НАЗНАЧЕНИЕ И МЕХАНИЗМ РАБОТЫ:" : "DESCRIPTION & MECHANICS:";
                                font-size: 15px;
                                font-weight: 700;
                                color: Theme.accent_blue;
                            }
                            Text {
                                text: doc.description;
                                font-size: 16px;
                                color: Theme.text_primary;
                                wrap: word-wrap;
                            }
                        }

                        // Section 2: Use Cases & Scenarios Callout Box
                        Rectangle {
                            border-radius: 4px;
                            background: Theme.bg_surface1;
                            clip: true;

                            HorizontalLayout {
                                Rectangle {
                                    width: 4px;
                                    background: Theme.accent_yellow;
                                }

                                VerticalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 4px;

                                    Text {
                                        text: root.current_language == "ru" ? "ТИПИЧНЫЕ СЦЕНАРИИ И ПРИМЕНЕНИЕ:" : "USE CASES & SCENARIOS:";
                                        font-size: 15px;
                                        font-weight: 700;
                                        color: Theme.accent_yellow;
                                    }
                                    Text {
                                        text: doc.when_to_use;
                                        font-size: 15px;
                                        color: Theme.text_primary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // Section 3: Operands & Flags Grid
                        HorizontalLayout {
                            spacing: 12px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 4px;
                                background: Theme.bg_surface1;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: (root.current_language == "ru" ? "Операнды: " : "Operands: ") + doc.operands;
                                        font-size: 14px;
                                        color: Theme.accent_green;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 4px;
                                background: Theme.bg_surface1;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: (root.current_language == "ru" ? "Влияние на флаги: " : "Flags affected: ") + doc.flags;
                                        font-size: 14px;
                                        color: Theme.accent_yellow;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Architectural Note / Pitfall
                        if doc.notes != "": Text {
                            text: (root.current_language == "ru" ? "Особенность: " : "Note: ") + doc.notes;
                            font-size: 14px;
                            color: Theme.text_muted;
                            font-italic: true;
                            wrap: word-wrap;
                        }

                        // Section 4: Practical Code Examples with Full Syntax Highlighting
                        VerticalLayout {
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: root.current_language == "ru" ? "ПРАКТИЧЕСКИЙ ПРИМЕР ИСПОЛЬЗОВАНИЯ:" : "PRACTICAL CODE EXAMPLE:";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.accent_blue;
                                    vertical-alignment: center;
                                }

                                // Button to Insert snippet into editor
                                Rectangle {
                                    width: 210px;
                                    height: 32px;
                                    border-radius: 4px;
                                    background: ins_btn.has-hover ? Theme.accent_green : Theme.bg_surface2;

                                    ins_btn := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.insert_snippet(doc.raw_snippet);
                                        }
                                    }

                                    Text {
                                        text: root.current_language == "ru" ? "Вставить пример в код" : "Insert Example into Code";
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: ins_btn.has-hover ? #151518 : Theme.text_primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Token-by-Token Syntax Highlighted Code Box (Full Height, No Bottom Clipping!)
                            Rectangle {
                                background: Theme.bg_dark;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border_light;

                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 3px;

                                    for eline in doc.example_lines: HorizontalLayout {
                                        height: 24px;
                                        alignment: start;
                                        spacing: 0px;

                                        for tok in eline.tokens: Text {
                                            text: tok.text;
                                            color: tok.color;
                                            font-family: "CaskaydiaCove Nerd Font Propo";
                                            font-size: 15px;
                                            font-weight: 600;
                                            font-italic: tok.is_italic;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }

    // MODULE 1: BDOS SYSTEM CALLS (0-36)
    if root.docs_active_module == 1: BdosView {
        current_language: root.current_language;
        selected_category <=> root.bdos_selected_category;
        bdos_list: root.bdos_list;
        bdos_total_count: root.bdos_total_count;
        fcb_fields_list: root.fcb_fields_list;
        buffer_fields_list: root.buffer_fields_list;
        filter_category(cat) => { root.filter_bdos_category(cat); }
        insert_snippet(snip) => { root.insert_snippet(snip); }
    }

    // MODULE 2: 64K MEMORY MAP
    if root.docs_active_module == 2: MemoryMapView {
        current_language: root.current_language;
        memory_map_list: root.memory_map_list;
        insert_snippet(snip) => { root.insert_snippet(snip); }
    }

    // MODULE 3: REGISTERS & PSW
    if root.docs_active_module == 3: RegistersView {
        current_language: root.current_language;
        registers_list: root.registers_list;
        flags_list: root.flags_list;
        flag_rules_list: root.flag_rules_list;
    }

    // MODULE 4: ASCII TABLE
    if root.docs_active_module == 4: AsciiView {
        current_language: root.current_language;
        ascii_list: root.ascii_list;
        copy_clipboard(code) => { root.copy_text_to_clipboard(code); }
    }

    // MODULE 5: CONDITIONAL JUMPS & IDIOMS
    if root.docs_active_module == 5: JumpsView {
        current_language: root.current_language;
        jumps_list: root.jumps_list;
        patterns_list: root.patterns_list;
        insert_snippet(snip) => { root.insert_snippet(snip); }
    }
}
