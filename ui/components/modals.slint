import { Theme } from "theme.slint";

export component LargeFileModal inherits Rectangle {
    in property <string> current_language: "ru";
    in property <string> modal_text: "";
    callback confirm_open();
    callback cancel_open();

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: #000000aa;

    TouchArea { }

    Rectangle {
        width: 500px;
        height: modal_col.preferred-height;
        background: Theme.menu_bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.accent_yellow;
        drop-shadow-blur: 20px;
        drop-shadow-color: #000000cc;

        modal_col := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/document.svg");
                        width: 22px;
                        height: 22px;
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Предупреждение о большом файле" : "Large File Warning";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.accent_yellow;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.modal_text;
                font-size: 13px;
                color: Theme.text_primary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                Rectangle {
                    width: 110px;
                    height: 32px;
                    border-radius: 4px;
                    background: cancel_touch.has-hover ? Theme.bg_surface2 : Theme.bg_surface1;
                    border-width: 1px;
                    border-color: Theme.border_normal;

                    Text {
                        text: root.current_language == "ru" ? "Отмена" : "Cancel";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cancel_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel_open(); }
                    }
                }

                Rectangle {
                    width: 150px;
                    height: 32px;
                    border-radius: 4px;
                    background: confirm_touch.has-hover ? #f9e2af : Theme.accent_yellow;

                    Text {
                        text: root.current_language == "ru" ? "Открыть всё равно" : "Open Anyway";
                        font-size: 13px;
                        font-weight: 700;
                        color: #151518;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    confirm_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.confirm_open(); }
                    }
                }
            }
        }
    }
}

export component DeletedTabModal inherits Rectangle {
    in property <string> current_language: "ru";
    callback keep_open();
    callback discard_and_close();

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: #000000aa;

    TouchArea { }

    Rectangle {
        width: 480px;
        height: del_modal_col.preferred-height;
        background: Theme.menu_bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.accent_red;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000cc;

        del_modal_col := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/delete.svg");
                        width: 22px;
                        height: 22px;
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Файл удален на диске" : "File Deleted on Disk";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.accent_red;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.current_language == "ru"
                    ? "Этот файл был удален с диска в проводнике. Закрытие вкладки приведет к безвозвратной потере несохраненного содержимого из памяти. Закрыть вкладку?"
                    : "This file has been deleted from disk. Closing the tab will discard the in-memory content permanently. Close tab anyway?";
                font-size: 13px;
                color: Theme.text_primary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                Rectangle {
                    width: 130px;
                    height: 32px;
                    border-radius: 4px;
                    background: keep_touch.has-hover ? Theme.bg_surface2 : Theme.bg_surface1;
                    border-width: 1px;
                    border-color: Theme.border_normal;

                    Text {
                        text: root.current_language == "ru" ? "Оставить вкладку" : "Keep Open";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    keep_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.keep_open(); }
                    }
                }

                Rectangle {
                    width: 150px;
                    height: 32px;
                    border-radius: 4px;
                    background: del_confirm_touch.has-hover ? #ff4d6d : Theme.accent_red;

                    Text {
                        text: root.current_language == "ru" ? "Закрыть и удалить" : "Discard & Close";
                        font-size: 13px;
                        font-weight: 700;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    del_confirm_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.discard_and_close(); }
                    }
                }
            }
        }
    }
}

export component DndConflictModal inherits Rectangle {
    in property <string> current_language: "ru";
    in property <string> conflict_filename: "";
    in-out property <string> conflict_new_name: "";
    callback cancel();
    callback replace_file();
    callback save_with_new_name();

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: #000000aa;

    TouchArea { }

    Rectangle {
        width: 530px;
        height: conflict_modal_col.preferred-height;
        background: Theme.menu_bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.accent_yellow;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000cc;

        conflict_modal_col := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/info.svg");
                        width: 22px;
                        height: 22px;
                        colorize: Theme.accent_yellow;
                    }
                }
                Text {
                    text: root.current_language == "ru" ? "Файл уже существует" : "File Already Exists";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.accent_yellow;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.current_language == "ru"
                    ? "В папке назначения уже есть файл с именем \"" + root.conflict_filename + "\". Выберите действие:"
                    : "The target folder already contains a file named \"" + root.conflict_filename + "\". Choose an action:";
                font-size: 13px;
                color: Theme.text_primary;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 6px;
                Text {
                    text: root.current_language == "ru" ? "Новое имя (для сохранения с другим названием):" : "New name (to save with a different name):";
                    font-size: 12px;
                    color: Theme.text_dim;
                }
                Rectangle {
                    height: 34px;
                    background: Theme.editor_bg;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: rename_input.has-focus ? Theme.accent_blue : Theme.border_normal;

                    rename_input := TextInput {
                        x: 8px;
                        y: 0px;
                        width: parent.width - 16px;
                        height: 100%;
                        vertical-alignment: center;
                        text <=> root.conflict_new_name;
                        color: Theme.text_primary;
                        font-size: 13px;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Rectangle {
                    width: 90px;
                    height: 32px;
                    border-radius: 4px;
                    background: conflict_cancel_touch.has-hover ? Theme.bg_surface2 : Theme.bg_surface1;
                    border-width: 1px;
                    border-color: Theme.border_normal;

                    Text {
                        text: root.current_language == "ru" ? "Отмена" : "Cancel";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    conflict_cancel_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel(); }
                    }
                }

                Rectangle {
                    width: 105px;
                    height: 32px;
                    border-radius: 4px;
                    background: conflict_replace_touch.has-hover ? #ff4d6d : Theme.accent_red;

                    Text {
                        text: root.current_language == "ru" ? "Заменить" : "Replace";
                        font-size: 13px;
                        font-weight: 700;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    conflict_replace_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.replace_file(); }
                    }
                }

                Rectangle {
                    width: 220px;
                    height: 32px;
                    border-radius: 4px;
                    background: conflict_save_as_touch.has-hover ? #a6e3a1 : #85c980;

                    Text {
                        text: root.current_language == "ru" ? "Сохранить под новым именем" : "Save with new name";
                        font-size: 12px;
                        font-weight: 700;
                        color: #151518;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    conflict_save_as_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if root.conflict_new_name != "" {
                                root.save_with_new_name();
                            }
                        }
                    }
                }
            }
        }
    }
}
