import { RegisterItem, FlagItem, FlagRuleItem } from "../../models.slint";
import { Theme } from "../theme.slint";
import { ListView } from "std-widgets.slint";

export component RegistersView inherits VerticalLayout {
    in property <string> current_language: "ru";
    in property <[RegisterItem]> registers_list: [];
    in property <[FlagItem]> flags_list: [];
    in property <[FlagRuleItem]> flag_rules_list: [];
    in-out property <string> selected_flag_name: "Z";
    in-out property <int> selected_flag_index: 1;

    spacing: 12px;

    // Registers Matrix Header
    Rectangle {
        background: Theme.terminal_bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border_normal;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: root.current_language == "ru" ? "РЕГИСТРОВАЯ МОДЕЛЬ INTEL 8080:" : "INTEL 8080 REGISTER MODEL:";
                font-size: 14px;
                font-weight: 700;
                color: Theme.accent_blue;
                overflow: elide;
            }

            // Grid of 8-bit and 16-bit registers
            HorizontalLayout {
                spacing: 6px;

                // Accumulator A
                Rectangle {
                    background: Theme.bg_surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.accent_yellow;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;
                        Text {
                            text: root.current_language == "ru" ? "A (Аккум.)" : "A (Accum.)";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.accent_yellow;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "8 бит | ALU и I/O" : "8-bit | ALU & I/O";
                            font-size: 12px;
                            color: Theme.text_muted;
                            wrap: word-wrap;
                        }
                    }
                }

                // BC pair
                Rectangle {
                    background: Theme.bg_surface;
                    border-radius: 4px;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;
                        Text {
                            text: root.current_language == "ru" ? "B | C (BC)" : "B | C (BC)";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.accent_blue;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "16 бит | Счетчик/BDOS" : "16-bit | Counter/BDOS";
                            font-size: 12px;
                            color: Theme.text_muted;
                            wrap: word-wrap;
                        }
                    }
                }

                // DE pair
                Rectangle {
                    background: Theme.bg_surface;
                    border-radius: 4px;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;
                        Text {
                            text: root.current_language == "ru" ? "D | E (DE)" : "D | E (DE)";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.accent_blue;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "16 бит | Указатель/Строки" : "16-bit | Pointer/Strings";
                            font-size: 12px;
                            color: Theme.text_muted;
                            wrap: word-wrap;
                        }
                    }
                }

                // HL pair
                Rectangle {
                    background: Theme.bg_surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.accent_green;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;
                        Text {
                            text: root.current_language == "ru" ? "H | L (HL / M)" : "H | L (HL / M)";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.accent_green;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "16 бит | База [HL]" : "16-bit | Base [HL]";
                            font-size: 12px;
                            color: Theme.text_muted;
                            wrap: word-wrap;
                        }
                    }
                }

                // SP and PC
                Rectangle {
                    background: Theme.bg_surface;
                    border-radius: 4px;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;
                        Text {
                            text: "SP / PC";
                            font-size: 14px;
                            font-weight: 700;
                            color: #bd93f9;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "16 бит | Стек и PC" : "16-bit | Stack & PC";
                            font-size: 12px;
                            color: Theme.text_muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // PSW (Flags Byte) Interactive Panel
    Rectangle {
        background: Theme.terminal_bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.accent_yellow;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            HorizontalLayout {
                alignment: space-between;
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: root.current_language == "ru"
                        ? "БАЙТ СОСТОЯНИЯ ПРОЦЕССОРА PSW (ФЛАГИ РЕГИСТРА F):"
                        : "PROGRAM STATUS WORD (PSW FLAGS BYTE F):";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.accent_yellow;
                    overflow: elide;
                }

                Text {
                    text: root.current_language == "ru" ? "Нажмите на флаг" : "Click a flag";
                    font-size: 12px;
                    color: Theme.text_muted;
                    vertical-alignment: center;
                }
            }

            // Interactive Byte Strip: Bit 7 to 0 (proportional cells so all 8 bits always fit)
            HorizontalLayout {
                height: 54px;
                spacing: 4px;

                // Bit 7: S
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;
                    border-radius: 4px;
                    background: root.selected_flag_index == 0 ? Theme.accent_yellow : Theme.bg_surface2;
                    ts := TouchArea { mouse-cursor: pointer; clicked => { root.selected_flag_index = 0; } }
                    VerticalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.current_language == "ru" ? "S (Б7)" : "S (b7)";
                            font-size: 13px;
                            font-weight: 700;
                            color: root.selected_flag_index == 0 ? #151518 : Theme.text_primary;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "Знак" : "Sign";
                            font-size: 12px;
                            font-weight: 500;
                            color: root.selected_flag_index == 0 ? #151518 : Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bit 6: Z
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;
                    border-radius: 4px;
                    background: root.selected_flag_index == 1 ? Theme.accent_yellow : Theme.bg_surface2;
                    tz := TouchArea { mouse-cursor: pointer; clicked => { root.selected_flag_index = 1; } }
                    VerticalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.current_language == "ru" ? "Z (Б6)" : "Z (b6)";
                            font-size: 13px;
                            font-weight: 700;
                            color: root.selected_flag_index == 1 ? #151518 : Theme.text_primary;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "Ноль" : "Zero";
                            font-size: 12px;
                            font-weight: 500;
                            color: root.selected_flag_index == 1 ? #151518 : Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bit 5: 0
                Rectangle {
                    horizontal-stretch: 0.8;
                    min-width: 0px;
                    clip: true;
                    border-radius: 4px;
                    background: #252528;
                    VerticalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.current_language == "ru" ? "0 (Б5)" : "0 (b5)";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "Фикс. 0" : "Fixed 0";
                            font-size: 12px;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bit 4: AC
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;
                    border-radius: 4px;
                    background: root.selected_flag_index == 2 ? Theme.accent_yellow : Theme.bg_surface2;
                    tac := TouchArea { mouse-cursor: pointer; clicked => { root.selected_flag_index = 2; } }
                    VerticalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.current_language == "ru" ? "AC (Б4)" : "AC (b4)";
                            font-size: 13px;
                            font-weight: 700;
                            color: root.selected_flag_index == 2 ? #151518 : Theme.text_primary;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: "Aux Carry";
                            font-size: 12px;
                            font-weight: 500;
                            color: root.selected_flag_index == 2 ? #151518 : Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bit 3: 0
                Rectangle {
                    horizontal-stretch: 0.8;
                    min-width: 0px;
                    clip: true;
                    border-radius: 4px;
                    background: #252528;
                    VerticalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.current_language == "ru" ? "0 (Б3)" : "0 (b3)";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "Фикс. 0" : "Fixed 0";
                            font-size: 12px;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bit 2: P
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;
                    border-radius: 4px;
                    background: root.selected_flag_index == 3 ? Theme.accent_yellow : Theme.bg_surface2;
                    tp := TouchArea { mouse-cursor: pointer; clicked => { root.selected_flag_index = 3; } }
                    VerticalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.current_language == "ru" ? "P (Б2)" : "P (b2)";
                            font-size: 13px;
                            font-weight: 700;
                            color: root.selected_flag_index == 3 ? #151518 : Theme.text_primary;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "Четн." : "Parity";
                            font-size: 12px;
                            font-weight: 500;
                            color: root.selected_flag_index == 3 ? #151518 : Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bit 1: 1
                Rectangle {
                    horizontal-stretch: 0.8;
                    min-width: 0px;
                    clip: true;
                    border-radius: 4px;
                    background: #252528;
                    VerticalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.current_language == "ru" ? "1 (Б1)" : "1 (b1)";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "Фикс. 1" : "Fixed 1";
                            font-size: 12px;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bit 0: CY
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;
                    border-radius: 4px;
                    background: root.selected_flag_index == 4 ? Theme.accent_yellow : Theme.bg_surface2;
                    tcy := TouchArea { mouse-cursor: pointer; clicked => { root.selected_flag_index = 4; } }
                    VerticalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.current_language == "ru" ? "CY (Б0)" : "CY (b0)";
                            font-size: 13px;
                            font-weight: 700;
                            color: root.selected_flag_index == 4 ? #151518 : Theme.text_primary;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_language == "ru" ? "Перенос" : "Carry";
                            font-size: 12px;
                            font-weight: 500;
                            color: root.selected_flag_index == 4 ? #151518 : Theme.text_muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            // Selected Flag Details (constrained width + word-wrap so text never overflows right border)
            Rectangle {
                background: Theme.bg_surface;
                border-radius: 6px;
                clip: true;

                if root.flags_list.length > root.selected_flag_index: VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: root.flags_list[root.selected_flag_index].title
                            + (root.current_language == "ru" ? " [Бит " : " [Bit ")
                            + root.flags_list[root.selected_flag_index].bit_index + "]";
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.accent_yellow;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.flags_list[root.selected_flag_index].description;
                        font-size: 14px;
                        color: Theme.text_primary;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        Rectangle {
                            background: Theme.bg_surface2;
                            border-radius: 4px;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            clip: true;

                            VerticalLayout {
                                padding: 10px;
                                Text {
                                    text: root.flags_list[root.selected_flag_index].when_set;
                                    font-size: 13px;
                                    color: Theme.accent_green;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            background: Theme.bg_surface2;
                            border-radius: 4px;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            clip: true;

                            VerticalLayout {
                                padding: 10px;
                                Text {
                                    text: root.flags_list[root.selected_flag_index].when_cleared;
                                    font-size: 13px;
                                    color: Theme.accent_red;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    Text {
                        text: (root.current_language == "ru" ? "Изменяется командами: " : "Modified by instructions: ") + root.flags_list[root.selected_flag_index].affected_by;
                        font-size: 13px;
                        color: Theme.text_muted;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // Flag Rules Summary Table
    Rectangle {
        vertical-stretch: 1;
        min-height: 160px;
        background: Theme.terminal_bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border_normal;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: root.current_language == "ru" ? "СВОДНЫЕ ПРАВИЛА ВЛИЯНИЯ КОМАНД НА ФЛАГИ:" : "SUMMARY RULES OF INSTRUCTION FLAG MODIFICATION:";
                font-size: 14px;
                font-weight: 700;
                color: Theme.accent_blue;
                overflow: elide;
            }

            ListView {
                vertical-stretch: 1;
                for r in root.flag_rules_list: VerticalLayout {
                    padding-top: 3px;
                    padding-bottom: 3px;

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            horizontal-stretch: 1.2;
                            min-width: 0px;
                            border-radius: 3px;
                            background: Theme.bg_surface2;
                            clip: true;
                            VerticalLayout {
                                alignment: center;
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                Text {
                                    text: r.op_group;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.accent_yellow;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 2.0;
                            min-width: 0px;
                            border-radius: 3px;
                            background: Theme.editor_bg;
                            clip: true;
                            VerticalLayout {
                                alignment: center;
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                Text {
                                    text: r.commands;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.accent_blue;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 2.2;
                            min-width: 0px;
                            clip: true;
                            VerticalLayout {
                                alignment: center;
                                padding-left: 4px;
                                padding-right: 4px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                Text {
                                    text: r.effect;
                                    font-size: 13px;
                                    color: Theme.text_primary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
