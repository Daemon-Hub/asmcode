import { SuggestionItem } from "../models.slint";
import { IconButton } from "icon_button.slint";
import { Theme } from "theme.slint";
import { LineEdit, ListView } from "std-widgets.slint";

export component RightDrawer inherits Rectangle {
    in property <string> current_language: "ru";
    in-out property <bool> right_drawer_expanded: true;
    in property <[SuggestionItem]> suggestion_list: [];
    in-out property <string> search_filter: "";

    in property <string> selected_sugg_name: "MOV";
    in property <string> selected_sugg_category: "Пересылка данных";
    in property <string> selected_sugg_syntax: "MOV r1, r2";
    in property <string> selected_sugg_summary: "Копирование байта из регистра/памяти в другой регистр/память.";
    in property <string> selected_sugg_flags: "None";
    in property <string> selected_sugg_cycles: "5 (r,r) / 7 (r,M or M,r)";
    in property <string> selected_sugg_icon_kind: "transfer";
    in property <string> selected_sugg_example: "mov a, b        ; Копировать B в A";

    callback filter_changed(string);
    callback select_suggestion(int);
    callback insert_suggestion(string);

    horizontal-stretch: 0;
    vertical-stretch: 1;
    width: root.right_drawer_expanded ? 340px : 38px;
    background: Theme.sidebar_bg;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 8px;
        spacing: 8px;

        // Drawer Header with Chevron Arrow
        HorizontalLayout {
            alignment: space-between;
            if root.right_drawer_expanded: Text {
                text: root.current_language == "ru" ? "АВТОДОПОЛНЕНИЕ / ПОДСКАЗКИ" : "INTELLISENSE";
                font-size: 12px;
                font-weight: 700;
                color: Theme.accent_blue;
                vertical-alignment: center;
            }

            IconButton {
                icon_source: root.right_drawer_expanded ? @image-url("../icons/chevron_right.svg") : @image-url("../icons/chevron_down.svg");
                icon_width: 14px;
                icon_height: 14px;
                btn_width: 24px;
                btn_height: 24px;
                clicked => { root.right_drawer_expanded = !root.right_drawer_expanded; }
            }
        }

        if root.right_drawer_expanded: LineEdit {
            placeholder-text: root.current_language == "ru" ? "Поиск команд 8080 (Ctrl+Пробел)..." : "Filter 8080 opcodes (Ctrl+Space)...";
            font-size: 14px;
            text <=> root.search_filter;
            edited(q) => { root.filter_changed(q); }
        }

        if root.right_drawer_expanded: Rectangle {
            vertical-stretch: 1;
            background: Theme.terminal_bg;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border_normal;
            clip: true;

            ListView {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;

                for sugg[idx] in root.suggestion_list: Rectangle {
                    height: 34px;
                    border-radius: 3px;
                    background: (root.selected_sugg_name == sugg.name) ? Theme.bg_surface2 : (sugg_row_touch.has-hover ? Theme.bg_surface1 : #00000000);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            if sugg.icon_kind == "transfer": Image { source: @image-url("../icons/grp_transfer.svg"); width: 14px; height: 14px; }
                            if sugg.icon_kind == "arith": Image { source: @image-url("../icons/grp_arith.svg"); width: 14px; height: 14px; }
                            if sugg.icon_kind == "logic": Image { source: @image-url("../icons/grp_logic.svg"); width: 14px; height: 14px; }
                            if sugg.icon_kind == "branch": Image { source: @image-url("../icons/grp_branch.svg"); width: 14px; height: 14px; }
                            if sugg.icon_kind == "stack": Image { source: @image-url("../icons/grp_stack.svg"); width: 14px; height: 14px; }
                            if sugg.icon_kind == "directive": Image { source: @image-url("../icons/grp_directive.svg"); width: 14px; height: 14px; }
                            if sugg.icon_kind == "label": Image { source: @image-url("../icons/label.svg"); width: 14px; height: 14px; }
                        }

                        Text {
                            text: sugg.name;
                            font-size: 14px;
                            font-weight: 700;
                            color: (sugg.icon_kind == "label") ? Theme.accent_yellow : Theme.accent_blue;
                            vertical-alignment: center;
                        }

                        Rectangle { }

                        Text {
                            text: sugg.category;
                            font-size: 12px;
                            color: Theme.text_muted;
                            vertical-alignment: center;
                        }
                    }

                    sugg_row_touch := TouchArea {
                        clicked => { root.select_suggestion(idx); }
                    }
                }
            }
        }

        // Instruction Tooltip Card
        if root.right_drawer_expanded: Rectangle {
            vertical-stretch: 0;
            height: card_layout.preferred-height;
            background: Theme.terminal_bg;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border_normal;

            card_layout := VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.selected_sugg_name;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.accent_blue;
                    }

                    Rectangle {
                        height: 24px;
                        border-radius: 3px;
                        background: Theme.bg_surface1;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.selected_sugg_cycles + (root.current_language == "ru" ? " тактов" : " cyc");
                                font-size: 11px;
                                color: Theme.accent_yellow;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: (root.current_language == "ru" ? "Формат: " : "Format: ") + root.selected_sugg_syntax;
                    font-family: "CaskaydiaCove Nerd Font Propo";
                    font-size: 13px;
                    color: Theme.accent_green;
                }

                Text {
                    text: (root.current_language == "ru" ? "Флаги: " : "Flags: ") + root.selected_sugg_flags;
                    font-size: 12px;
                    color: Theme.accent_yellow;
                }

                Text {
                    text: root.selected_sugg_summary;
                    font-size: 13px;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }

                // Usage Example inside Card
                Rectangle {
                    height: 34px;
                    background: Theme.bg_base;
                    border-radius: 3px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: root.selected_sugg_example;
                            font-family: "CaskaydiaCove Nerd Font Propo";
                            font-size: 12px;
                            color: Theme.accent_blue;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: Theme.accent_blue;
                    Text {
                        text: root.current_language == "ru" ? "Вставить шаблон" : "Insert Template";
                        font-size: 13px;
                        font-weight: 600;
                        color: #151518;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            root.insert_suggestion(root.selected_sugg_syntax);
                        }
                    }
                }
            }
        }

        if !root.right_drawer_expanded: Rectangle {
            vertical-stretch: 1;
        }
    }
}
