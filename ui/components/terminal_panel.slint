import { TerminalLineItem } from "../models.slint";
import { IconButton } from "icon_button.slint";
import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

export component TerminalPanel inherits Rectangle {
    in property <string> current_language: "ru";
    in-out property <bool> terminal_expanded: true;
    in property <length> terminal_height: 180px;
    in property <string> status_message: "Ready";
    in property <color> status_color: #a6e3a1;
    in property <string> output_log_text: "";
    in property <[TerminalLineItem]> terminal_lines: [];

    callback clear_output();

    height: root.terminal_expanded ? (root.terminal_height + 38px) : 38px;
    background: Theme.terminal_bg;

    VerticalLayout {
        padding: 6px;
        spacing: 6px;

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 8px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;

                IconButton {
                    icon_source: root.terminal_expanded ? @image-url("../icons/chevron_down.svg") : @image-url("../icons/arrow_up.svg");
                    icon_width: 14px;
                    icon_height: 14px;
                    btn_width: 24px;
                    btn_height: 24px;
                    clicked => { root.terminal_expanded = !root.terminal_expanded; }
                }

                Text {
                    text: root.current_language == "ru"
                        ? "ТЕРМИНАЛ / ВЫВОД КОМПИЛЯТОРА И ЭМУЛЯТОРА"
                        : "TERMINAL / COMPILER & EMULATOR OUTPUT";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text_muted;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 22px;
                    border-radius: 3px;
                    background: Theme.bg_surface1;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: root.status_message;
                            font-size: 12px;
                            color: root.status_color;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                width: 95px;
                height: 26px;
                border-radius: 3px;
                background: Theme.bg_surface;
                border-width: 1px;
                border-color: Theme.border_normal;

                Text {
                    text: root.current_language == "ru" ? "Очистить" : "Clear";
                    font-size: 12px;
                    color: Theme.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.clear_output(); }
                }
            }
        }

        if root.terminal_expanded: Rectangle {
            background: Theme.bg_base;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border_normal;

            ScrollView {
                VerticalLayout {
                    padding: 8px;
                    spacing: 3px;
                    alignment: start;

                    if root.terminal_lines.length == 0: Text {
                        text: root.output_log_text;
                        font-family: "CaskaydiaCove NF SemiBold";
                        font-size: 14px;
                        color: #cdd6f4;
                        wrap: word-wrap;
                    }

                    for line in root.terminal_lines: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        if line.prefix != "": Text {
                            text: line.prefix;
                            color: line.prefix_color;
                            font-family: "CaskaydiaCove NF SemiBold";
                            font-size: 13px;
                            font-weight: 700;
                        }

                        Text {
                            text: line.text;
                            color: line.text_color;
                            font-family: "CaskaydiaCove NF SemiBold";
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
