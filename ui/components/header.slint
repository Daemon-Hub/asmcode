import { IconButton } from "icon_button.slint";
import { ActionButton } from "action_button.slint";
import { Theme } from "theme.slint";

export component Header inherits Rectangle {
    in property <string> current_language: "ru";
    in property <string> active_file_name: "";
    in property <bool> is_dirty: false;
    in property <bool> is_active_asm: true;
    in property <int> editor_mode: 0;
    in-out property <string> docs_search_query: "";

    in property <bool> show_file_menu: false;
    in property <bool> show_run_menu: false;
    in property <bool> show_view_menu: false;
    in property <bool> show_help_menu: false;

    callback toggle_file_menu();
    callback toggle_run_menu();
    callback toggle_view_menu();
    callback toggle_help_menu();
    callback close_active_file();
    callback toggle_docs_mode();
    callback search_docs(string);
    callback save_file();
    callback run_syntax_check();
    callback run_assemble_only();
    callback run_emulator();

    height: 58px;
    background: Theme.header_bg;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: space-between;

        // Left: Thematic 8080 Brand Logo, Menus, and Active Document Tab
        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                // Brand Title
                HorizontalLayout {
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/app_8080.svg");
                            width: 22px;
                            height: 22px;
                        }
                    }

                    Text {
                        text: "ASM Code";
                        font-family: "CaskaydiaCove Nerd Font Propo";
                        font-size: 19px;
                        font-weight: 700;
                        color: Theme.accent_blue;
                        vertical-alignment: center;
                    }
                }

                // File Menu Button
                Rectangle {
                    width: 66px;
                    height: 34px;
                    border-radius: 4px;
                    background: root.show_file_menu ? Theme.bg_surface1 : #00000000;
                    Text {
                        text: root.current_language == "ru" ? "Файл" : "File";
                        font-size: 15px;
                        color: Theme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.toggle_file_menu(); }
                    }
                }

                // Run Menu Button
                Rectangle {
                    width: 66px;
                    height: 34px;
                    border-radius: 4px;
                    background: root.show_run_menu ? Theme.bg_surface1 : #00000000;
                    Text {
                        text: root.current_language == "ru" ? "Запуск" : "Run";
                        font-size: 15px;
                        color: Theme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.toggle_run_menu(); }
                    }
                }

                // View Menu Button
                Rectangle {
                    width: 66px;
                    height: 34px;
                    border-radius: 4px;
                    background: root.show_view_menu ? Theme.bg_surface1 : #00000000;
                    Text {
                        text: root.current_language == "ru" ? "Вид" : "View";
                        font-size: 15px;
                        color: Theme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.toggle_view_menu(); }
                    }
                }

                // Help Menu Button
                Rectangle {
                    width: 76px;
                    height: 34px;
                    border-radius: 4px;
                    background: root.show_help_menu ? Theme.bg_surface1 : #00000000;
                    Text {
                        text: root.current_language == "ru" ? "Справка" : "Help";
                        font-size: 15px;
                        color: Theme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.toggle_help_menu(); }
                    }
                }
            }
        }

        // Right: Action Buttons with Vector Icons
        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                // Compact Docs Search Box (visible in 8080 Docs mode)
                if root.editor_mode == 2: Rectangle {
                    width: 260px;
                    height: 34px;
                    background: Theme.bg_surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: hdr_search_inp.has-focus ? Theme.accent_blue : Theme.border_normal;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/search_lens.svg");
                                width: 15px;
                                height: 15px;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;

                            if root.docs_search_query == "" && !hdr_search_inp.has-focus: Text {
                                width: 100%;
                                height: 100%;
                                text: root.current_language == "ru" ? "Поиск по справке..." : "Search docs...";
                                font-size: 13px;
                                color: Theme.text_muted;
                                vertical-alignment: center;
                            }

                            hdr_search_inp := TextInput {
                                width: 100%;
                                height: 100%;
                                font-size: 13px;
                                color: Theme.text_primary;
                                single-line: true;
                                vertical-alignment: center;
                                text <=> root.docs_search_query;
                                edited => {
                                    root.search_docs(self.text);
                                }
                            }
                        }

                        if root.docs_search_query != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: hdr_clr_touch.has-hover ? Theme.bg_surface2 : #00000000;
                                hdr_clr_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.docs_search_query = "";
                                        root.search_docs("");
                                    }
                                }
                                Text {
                                    text: "×";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.text_muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Toggle Editor vs Docs
                ActionButton {
                    text: root.current_language == "ru"
                        ? (root.editor_mode == 2 ? "Редактор" : "Справка 8080")
                        : (root.editor_mode == 2 ? "Editor" : "8080 Docs");
                    icon_source: root.editor_mode == 2 ? @image-url("../icons/editor.svg") : @image-url("../icons/book.svg");
                    text_color: root.editor_mode == 2 ? #89b4fa : #cdd6f4;
                    bg_normal: root.editor_mode == 2 ? #1e2238 : #1e1e2e;
                    bg_hover: root.editor_mode == 2 ? #2e344e : #313244;
                    border_color_normal: root.editor_mode == 2 ? #89b4fa : #45475a;
                    border_color_hover: #89b4fa;
                    clicked => { root.toggle_docs_mode(); }
                }

                // Save Button
                ActionButton {
                    text: root.current_language == "ru" ? "Сохранить" : "Save";
                    icon_source: @image-url("../icons/save.svg");
                    clicked => { root.save_file(); }
                }

                // Syntax Check
                ActionButton {
                    text: root.current_language == "ru" ? "Проверить" : "Check";
                    icon_source: @image-url("../icons/check.svg");
                    text_color: #a6e3a1;
                    border_color_hover: #a6e3a1;
                    clicked => { root.run_syntax_check(); }
                }

                // Assemble Only
                ActionButton {
                    text: root.current_language == "ru" ? "Собрать .COM" : "Build .COM";
                    icon_source: @image-url("../icons/build.svg");
                    text_color: #89b4fa;
                    border_color_hover: #89b4fa;
                    clicked => { root.run_assemble_only(); }
                }

                // Run in CP/M Emulator
                ActionButton {
                    text: root.current_language == "ru" ? "Запуск" : "Run";
                    icon_source: @image-url("../icons/run.svg");
                    text_color: #a6e3a1;
                    text_font_weight: 700;
                    bg_normal: #1e3325;
                    bg_hover: #2e4a36;
                    bg_pressed: #3e664b;
                    border_color_normal: #585b70;
                    border_color_hover: #a6e3a1;
                    padding_horizontal: 14px;
                    clicked => { root.run_emulator(); }
                }
            }
        }
    }
}
