import { Theme } from "theme.slint";

export component ExplorerContextMenu inherits Rectangle {
    in property <string> current_language: "ru";
    in property <string> selected_explorer_path: "";
    in property <string> selected_explorer_name: "";

    callback create_new_file();
    callback create_new_folder();
    callback rename_requested();
    callback delete_requested(string);
    callback undo_delete_requested();
    callback copy_path_requested(string);
    callback reveal_in_explorer_requested(string);
    callback refresh_requested();

    width: 240px;
    height: exp_menu_layout.preferred-height;
    background: Theme.menu_bg;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.menu_border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #000000bb;
    z: 110;

    exp_menu_layout := VerticalLayout {
        padding: 6px;
        spacing: 2px;

        // New File
        Rectangle {
            height: 30px;
            border-radius: 4px;
            background: exp_m_newfile.has-hover ? Theme.menu_hover : #00000000;
            exp_m_newfile := TouchArea {
                clicked => { root.create_new_file(); }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/plus.svg"); width: 14px; height: 14px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Новый файл..." : "New File...";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        // New Folder
        Rectangle {
            height: 30px;
            border-radius: 4px;
            background: exp_m_newfolder.has-hover ? Theme.menu_hover : #00000000;
            exp_m_newfolder := TouchArea {
                clicked => { root.create_new_folder(); }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/folder.svg"); width: 14px; height: 14px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Новая папка..." : "New Folder...";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border_normal; }

        // Rename
        Rectangle {
            height: 30px;
            border-radius: 4px;
            background: exp_m_rename.has-hover ? Theme.menu_hover : #00000000;
            exp_m_rename := TouchArea {
                clicked => {
                    if root.selected_explorer_name != "" {
                        root.rename_requested();
                    }
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/editor.svg"); width: 14px; height: 14px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Переименовать..." : "Rename...";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        // Delete
        Rectangle {
            height: 30px;
            border-radius: 4px;
            background: exp_m_del.has-hover ? Theme.menu_hover : #00000000;
            exp_m_del := TouchArea {
                clicked => {
                    if root.selected_explorer_path != "" {
                        root.delete_requested(root.selected_explorer_path);
                    }
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/delete.svg"); width: 14px; height: 14px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Удалить" : "Delete";
                    font-size: 13px;
                    color: Theme.accent_red;
                    vertical-alignment: center;
                }
            }
        }

        // Undo Delete (Ctrl+Z)
        Rectangle {
            height: 30px;
            border-radius: 4px;
            background: exp_m_undo.has-hover ? Theme.menu_hover : #00000000;
            exp_m_undo := TouchArea {
                clicked => { root.undo_delete_requested(); }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../icons/refresh.svg"); width: 14px; height: 14px; }
                    }
                    Text {
                        text: root.current_language == "ru" ? "Отменить удаление" : "Undo Delete";
                        font-size: 13px;
                        color: Theme.accent_yellow;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "Ctrl+Z";
                    font-size: 11px;
                    color: Theme.text_muted;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border_normal; }

        // Copy Path
        Rectangle {
            height: 30px;
            border-radius: 4px;
            background: exp_m_copy.has-hover ? Theme.menu_hover : #00000000;
            exp_m_copy := TouchArea {
                clicked => {
                    if root.selected_explorer_path != "" {
                        root.copy_path_requested(root.selected_explorer_path);
                    }
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/copy.svg"); width: 14px; height: 14px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Копировать путь" : "Copy Path";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        // Reveal in System File Manager
        Rectangle {
            height: 30px;
            border-radius: 4px;
            background: exp_m_rev.has-hover ? Theme.menu_hover : #00000000;
            exp_m_rev := TouchArea {
                clicked => {
                    if root.selected_explorer_path != "" {
                        root.reveal_in_explorer_requested(root.selected_explorer_path);
                    }
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/folder-windows-open.svg"); width: 14px; height: 14px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Показать в проводнике системы" : "Reveal in File Manager";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        // Refresh
        Rectangle {
            height: 30px;
            border-radius: 4px;
            background: exp_m_ref.has-hover ? Theme.menu_hover : #00000000;
            exp_m_ref := TouchArea {
                clicked => { root.refresh_requested(); }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/refresh.svg"); width: 14px; height: 14px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Обновить проводник" : "Refresh";
                    font-size: 13px;
                    color: Theme.accent_blue;
                    vertical-alignment: center;
                }
            }
        }
    }
}
