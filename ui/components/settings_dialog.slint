import { Theme } from "theme.slint";

export component SettingsDialog inherits Rectangle {
    in property <string> current_language: "ru";
    in-out property <int> active_tab: 0; // 0 = Editor, 1 = Appearance, 2 = Large Files, 3 = Toolchain

    // Editor settings
    in-out property <length> editor_font_size: 18px;
    in-out property <bool> editor_font_italic: false;
    in-out property <bool> cursor_blink: true;
    in-out property <int> tab_size: 4;

    // Appearance
    in-out property <int> active_theme_id: 1;
    in-out property <string> selected_language: "ru";

    // Large files
    in-out property <bool> large_file_optimizations: true;
    in-out property <int> soft_limit_mb: 20;
    in-out property <int> soft_limit_lines: 300000;
    in-out property <int> hard_limit_mb: 500;

    // Toolchain
    in-out property <int> toolchain_type: 0; // 0 = Default (intel-8080-kit built-in), 1 = External binary
    in-out property <string> compiler_path: "";
    in-out property <string> emulator_path: "";

    callback close_dialog();
    callback save_settings();
    callback reset_defaults();
    callback browse_compiler();
    callback browse_emulator();

    width: 780px;
    height: 520px;
    background: Theme.menu_bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.menu_border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000cc;
    z: 250;

    // Absorb clicks on dialog background so they never pass to modal backdrop
    TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Modal Header
        Rectangle {
            height: 48px;
            background: Theme.header_bg;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border_normal;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/settings.svg");
                            width: 18px;
                            height: 18px;
                        }
                    }
                    Text {
                        text: root.current_language == "ru" ? "Настройки IDE" : "IDE Settings";
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.accent_yellow;
                        vertical-alignment: center;
                    }
                }

                // Close 'X' Button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: 10px;
                    border-radius: 14px;
                    background: close_touch.has-hover ? Theme.bg_surface2 : #00000000;

                    Image {
                        source: @image-url("../icons/close.svg");
                        width: 12px;
                        height: 12px;
                        x: 8px;
                        y: 8px;
                    }

                    close_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close_dialog(); }
                    }
                }
            }
        }

        // Body: Left Category Tabs + Right Settings Pane
        HorizontalLayout {
            vertical-stretch: 1;

            // Left Category Tabs Column
            Rectangle {
                width: 200px;
                background: Theme.sidebar_bg;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: Theme.border_normal;
                }

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    alignment: start;

                    // Tab 0: Editor
                    Rectangle {
                        height: 36px;
                        border-radius: 4px;
                        background: root.active_tab == 0 ? Theme.bg_surface1 : (t0_touch.has-hover ? Theme.menu_hover : #00000000);
                        t0_touch := TouchArea { clicked => { root.active_tab = 0; } }
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Image { source: @image-url("../icons/editor.svg"); width: 15px; height: 15px; } }
                            Text {
                                text: root.current_language == "ru" ? "Редактор кода" : "Editor";
                                font-size: 13px;
                                font-weight: root.active_tab == 0 ? 700 : 500;
                                color: root.active_tab == 0 ? Theme.accent_blue : Theme.text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tab 1: Appearance
                    Rectangle {
                        height: 36px;
                        border-radius: 4px;
                        background: root.active_tab == 1 ? Theme.bg_surface1 : (t1_touch.has-hover ? Theme.menu_hover : #00000000);
                        t1_touch := TouchArea { clicked => { root.active_tab = 1; } }
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Image { source: @image-url("../icons/palette.svg"); width: 15px; height: 15px; } }
                            Text {
                                text: root.current_language == "ru" ? "Внешний вид" : "Appearance";
                                font-size: 13px;
                                font-weight: root.active_tab == 1 ? 700 : 500;
                                color: root.active_tab == 1 ? Theme.accent_blue : Theme.text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tab 2: Large Files
                    Rectangle {
                        height: 36px;
                        border-radius: 4px;
                        background: root.active_tab == 2 ? Theme.bg_surface1 : (t2_touch.has-hover ? Theme.menu_hover : #00000000);
                        t2_touch := TouchArea { clicked => { root.active_tab = 2; } }
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Image { source: @image-url("../icons/document.svg"); width: 15px; height: 15px; } }
                            Text {
                                text: root.current_language == "ru" ? "Большие файлы" : "Large Files";
                                font-size: 13px;
                                font-weight: root.active_tab == 2 ? 700 : 500;
                                color: root.active_tab == 2 ? Theme.accent_blue : Theme.text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tab 3: Toolchain
                    Rectangle {
                        height: 36px;
                        border-radius: 4px;
                        background: root.active_tab == 3 ? Theme.bg_surface1 : (t3_touch.has-hover ? Theme.menu_hover : #00000000);
                        t3_touch := TouchArea { clicked => { root.active_tab = 3; } }
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Image { source: @image-url("../icons/build.svg"); width: 15px; height: 15px; } }
                            Text {
                                text: root.current_language == "ru" ? "Тулчейн (Сборка)" : "Toolchain";
                                font-size: 13px;
                                font-weight: root.active_tab == 3 ? 700 : 500;
                                color: root.active_tab == 3 ? Theme.accent_blue : Theme.text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Right Settings Details Pane
            Rectangle {
                background: Theme.editor_bg;
                clip: true;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    alignment: center;

                    // TAB 0: EDITOR SETTINGS
                    if root.active_tab == 0: VerticalLayout {
                        spacing: 14px;
                        alignment: center;

                        // Font size
                        Rectangle {
                            height: 40px;
                            border-radius: 4px;
                            background: Theme.bg_surface1;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: (root.current_language == "ru" ? "Размер шрифта: " : "Font size: ") + (root.editor_font_size / 1px) + " px";
                                    font-size: 13px;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 32px;
                                            height: 26px;
                                            border-radius: 3px;
                                            background: Theme.bg_surface2;
                                            Text { text: "-"; font-size: 16px; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea {
                                                clicked => {
                                                    if root.editor_font_size > 12px { root.editor_font_size -= 2px; }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 32px;
                                            height: 26px;
                                            border-radius: 3px;
                                            background: Theme.bg_surface2;
                                            Text { text: "+"; font-size: 16px; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea {
                                                clicked => {
                                                    if root.editor_font_size < 36px { root.editor_font_size += 2px; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Italic font
                        Rectangle {
                            height: 40px;
                            border-radius: 4px;
                            background: Theme.bg_surface1;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: root.current_language == "ru" ? "Курсивный шрифт для директив" : "Italic font for directives";
                                    font-size: 13px;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 44px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: root.editor_font_italic ? Theme.accent_blue : Theme.bg_surface2;
                                        Rectangle {
                                            x: root.editor_font_italic ? 22px : 2px;
                                            y: 2px;
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: #ffffff;
                                        }
                                        TouchArea { clicked => { root.editor_font_italic = !root.editor_font_italic; } }
                                    }
                                }
                            }
                        }

                        // Cursor blink
                        Rectangle {
                            height: 40px;
                            border-radius: 4px;
                            background: Theme.bg_surface1;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: root.current_language == "ru" ? "Анимация мигания курсора" : "Cursor blinking animation";
                                    font-size: 13px;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 44px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: root.cursor_blink ? Theme.accent_green : Theme.bg_surface2;
                                        Rectangle {
                                            x: root.cursor_blink ? 22px : 2px;
                                            y: 2px;
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: #ffffff;
                                        }
                                        TouchArea { clicked => { root.cursor_blink = !root.cursor_blink; } }
                                    }
                                }
                            }
                        }

                        // Tab size
                        Rectangle {
                            height: 40px;
                            border-radius: 4px;
                            background: Theme.bg_surface1;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: (root.current_language == "ru" ? "Ширина табуляции: " : "Tab size: ") + root.tab_size + (root.current_language == "ru" ? " пробела" : " spaces");
                                    font-size: 13px;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Rectangle {
                                            width: 38px;
                                            height: 26px;
                                            border-radius: 3px;
                                            background: root.tab_size == 2 ? Theme.accent_blue : Theme.bg_surface2;
                                            Text { text: "2"; font-size: 12px; font-weight: 700; color: root.tab_size == 2 ? #151518 : Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.tab_size = 2; } }
                                        }
                                        Rectangle {
                                            width: 38px;
                                            height: 26px;
                                            border-radius: 3px;
                                            background: root.tab_size == 4 ? Theme.accent_blue : Theme.bg_surface2;
                                            Text { text: "4"; font-size: 12px; font-weight: 700; color: root.tab_size == 4 ? #151518 : Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.tab_size = 4; } }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 1: APPEARANCE
                    if root.active_tab == 1: VerticalLayout {
                        spacing: 14px;

                        // Theme selection
                        Rectangle {
                            height: 80px;
                            border-radius: 4px;
                            background: Theme.bg_surface1;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Text {
                                    text: root.current_language == "ru" ? "Цветовая тема интерфейса:" : "Color Theme:";
                                    font-size: 13px;
                                    color: Theme.text_muted;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        height: 32px;
                                        border-radius: 4px;
                                        background: root.active_theme_id == 1 ? Theme.accent_blue : Theme.bg_surface2;
                                        Text {
                                            text: "Cyberpunk 2077 Red";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: root.active_theme_id == 1 ? #151518 : Theme.text_primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { clicked => { root.active_theme_id = 1; } }
                                    }
                                    Rectangle {
                                        height: 32px;
                                        border-radius: 4px;
                                        background: root.active_theme_id == 0 ? Theme.accent_blue : Theme.bg_surface2;
                                        Text {
                                            text: "Catppuccin Dark";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: root.active_theme_id == 0 ? #151518 : Theme.text_primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { clicked => { root.active_theme_id = 0; } }
                                    }
                                }
                            }
                        }

                        // Language selection
                        Rectangle {
                            height: 80px;
                            border-radius: 4px;
                            background: Theme.bg_surface1;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Text {
                                    text: root.current_language == "ru" ? "Язык интерфейса:" : "Interface Language:";
                                    font-size: 13px;
                                    color: Theme.text_muted;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        height: 32px;
                                        border-radius: 4px;
                                        background: root.selected_language == "ru" ? Theme.accent_green : Theme.bg_surface2;
                                        Text {
                                            text: "Русский (RU)";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: root.selected_language == "ru" ? #151518 : Theme.text_primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { clicked => { root.selected_language = "ru"; } }
                                    }
                                    Rectangle {
                                        height: 32px;
                                        border-radius: 4px;
                                        background: root.selected_language == "en" ? Theme.accent_green : Theme.bg_surface2;
                                        Text {
                                            text: "English (EN)";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: root.selected_language == "en" ? #151518 : Theme.text_primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { clicked => { root.selected_language = "en"; } }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 2: LARGE FILE OPTIMIZATIONS
                    if root.active_tab == 2: VerticalLayout {
                        spacing: 14px;
                        alignment: center;

                        // Enabled toggle
                        Rectangle {
                            height: 40px;
                            border-radius: 4px;
                            background: Theme.bg_surface1;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: root.current_language == "ru" ? "Оптимизация больших файлов" : "Large File Optimizations";
                                    font-size: 13px;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 44px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: root.large_file_optimizations ? Theme.accent_yellow : Theme.bg_surface2;
                                        Rectangle {
                                            x: root.large_file_optimizations ? 22px : 2px;
                                            y: 2px;
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: #ffffff;
                                        }
                                        TouchArea { clicked => { root.large_file_optimizations = !root.large_file_optimizations; } }
                                    }
                                }
                            }
                        }

                        // Soft limit MB
                        Rectangle {
                            height: 40px;
                            border-radius: 4px;
                            background: Theme.bg_surface1;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: (root.current_language == "ru" ? "Порог авто-оптимизации: " : "Soft limit: ") + root.soft_limit_mb + " MB";
                                    font-size: 13px;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Rectangle {
                                            width: 34px; height: 26px; border-radius: 3px; background: Theme.bg_surface2;
                                            Text { text: "-5"; font-size: 12px; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { if root.soft_limit_mb > 5 { root.soft_limit_mb -= 5; } } }
                                        }
                                        Rectangle {
                                            width: 34px; height: 26px; border-radius: 3px; background: Theme.bg_surface2;
                                            Text { text: "+5"; font-size: 12px; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { if root.soft_limit_mb < 200 { root.soft_limit_mb += 5; } } }
                                        }
                                    }
                                }
                            }
                        }

                        // Hard limit MB
                        Rectangle {
                            height: 40px;
                            border-radius: 4px;
                            background: Theme.bg_surface1;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: (root.current_language == "ru" ? "Порог предупреждения ОЗУ: " : "Hard limit: ") + root.hard_limit_mb + " MB";
                                    font-size: 13px;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Rectangle {
                                            width: 44px; height: 26px; border-radius: 3px; background: Theme.bg_surface2;
                                            Text { text: "-50"; font-size: 12px; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { if root.hard_limit_mb > 100 { root.hard_limit_mb -= 50; } } }
                                        }
                                        Rectangle {
                                            width: 44px; height: 26px; border-radius: 3px; background: Theme.bg_surface2;
                                            Text { text: "+50"; font-size: 12px; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { if root.hard_limit_mb < 2000 { root.hard_limit_mb += 50; } } }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 3: TOOLCHAIN SETTINGS
                    if root.active_tab == 3: VerticalLayout {
                        spacing: 12px;
                        alignment: center;

                        Text {
                            text: root.current_language == "ru" ? "Режим тулчейна (компилятор и эмулятор):" : "Toolchain Mode (Compiler & Emulator):";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.accent_yellow;
                        }

                        // Choice 1: Default Built-in Toolchain
                        Rectangle {
                            height: 54px;
                            border-radius: 4px;
                            background: root.toolchain_type == 0 ? Theme.bg_surface1 : Theme.editor_bg;
                            border-width: 1px;
                            border-color: root.toolchain_type == 0 ? Theme.accent_blue : Theme.border_normal;

                            TouchArea {
                                clicked => { root.toolchain_type = 0; }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;

                                // Radio circle
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.toolchain_type == 0 ? Theme.accent_blue : Theme.text_muted;
                                        background: #00000000;

                                        if root.toolchain_type == 0: Rectangle {
                                            x: 3px;
                                            y: 3px;
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: Theme.accent_blue;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: root.current_language == "ru" ? "1) По умолчанию (Встроенный pure-Rust движок)" : "1) Default (Built-in pure-Rust engine)";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: root.toolchain_type == 0 ? Theme.accent_blue : Theme.text_primary;
                                    }
                                    Text {
                                        text: root.current_language == "ru" ? "Встроенный ассемблер и эмулятор intel-8080-kit. Не требует внешних файлов." : "Built-in intel-8080-kit assembler and emulator. Zero external dependencies.";
                                        font-size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }
                            }
                        }

                        // Choice 2: External Binary Toolchain
                        Rectangle {
                            height: 54px;
                            border-radius: 4px;
                            background: root.toolchain_type == 1 ? Theme.bg_surface1 : Theme.editor_bg;
                            border-width: 1px;
                            border-color: root.toolchain_type == 1 ? Theme.accent_blue : Theme.border_normal;

                            TouchArea {
                                clicked => { root.toolchain_type = 1; }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;

                                // Radio circle
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.toolchain_type == 1 ? Theme.accent_blue : Theme.text_muted;
                                        background: #00000000;

                                        if root.toolchain_type == 1: Rectangle {
                                            x: 3px;
                                            y: 3px;
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: Theme.accent_blue;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: root.current_language == "ru" ? "2) Путь к бинарнику (Внешние asmx20 + cpmemu)" : "2) Custom Binary Path (External asmx20 + cpmemu)";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: root.toolchain_type == 1 ? Theme.accent_blue : Theme.text_primary;
                                    }
                                    Text {
                                        text: root.current_language == "ru" ? "Использовать внешние утилиты компилятора и эмулятора по указанным путям." : "Use external compiler and emulator binaries at specified file paths.";
                                        font-size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }
                            }
                        }

                        // When External Binary is selected: show path pickers
                        if root.toolchain_type == 1: VerticalLayout {
                            spacing: 10px;

                            // Compiler Path
                            Rectangle {
                                height: 58px;
                                border-radius: 4px;
                                background: Theme.bg_surface1;
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;
                                    Text {
                                        text: root.current_language == "ru" ? "Путь к компилятору (asmx20):" : "Compiler Path (asmx20):";
                                        font-size: 12px;
                                        color: Theme.text_muted;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 28px;
                                            background: Theme.editor_bg;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: Theme.border_normal;
                                            Text {
                                                x: 8px;
                                                text: root.compiler_path;
                                                font-size: 12px;
                                                color: Theme.text_primary;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        Rectangle {
                                            width: 80px;
                                            height: 28px;
                                            border-radius: 3px;
                                            background: Theme.bg_surface2;
                                            Text {
                                                text: root.current_language == "ru" ? "Обзор..." : "Browse...";
                                                font-size: 12px;
                                                color: Theme.accent_blue;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.browse_compiler(); } }
                                        }
                                    }
                                }
                            }

                            // Emulator Path
                            Rectangle {
                                height: 58px;
                                border-radius: 4px;
                                background: Theme.bg_surface1;
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;
                                    Text {
                                        text: root.current_language == "ru" ? "Путь к эмулятору (cpmemu):" : "Emulator Path (cpmemu):";
                                        font-size: 12px;
                                        color: Theme.text_muted;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 28px;
                                            background: Theme.editor_bg;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: Theme.border_normal;
                                            Text {
                                                x: 8px;
                                                text: root.emulator_path;
                                                font-size: 12px;
                                                color: Theme.text_primary;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        Rectangle {
                                            width: 80px;
                                            height: 28px;
                                            border-radius: 3px;
                                            background: Theme.bg_surface2;
                                            Text {
                                                text: root.current_language == "ru" ? "Обзор..." : "Browse...";
                                                font-size: 12px;
                                                color: Theme.accent_blue;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.browse_emulator(); } }
                                        }
                                    }
                                }
                            }

                            // Fallback Warning Notice
                            Text {
                                text: root.current_language == "ru" ? "Если бинарник не найден или путь недействителен, автоматически применяется тулчейн по умолчанию с предупреждением." : "If binary is not found or path is invalid, default toolchain is automatically applied with a warning.";
                                font-size: 11px;
                                color: Theme.accent_yellow;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // Modal Action Footer Bar
        Rectangle {
            height: 52px;
            background: Theme.header_bg;
            border-bottom-left-radius: 8px;
            border-bottom-right-radius: 8px;

            Rectangle {
                y: 0px;
                width: 100%;
                height: 1px;
                background: Theme.border_normal;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                // Reset Defaults
                Rectangle {
                    width: 160px;
                    height: 32px;
                    y: 10px;
                    border-radius: 4px;
                    background: rst_touch.has-hover ? Theme.bg_surface2 : #00000000;
                    border-width: 1px;
                    border-color: Theme.border_normal;

                    Text {
                        text: root.current_language == "ru" ? "Сбросить по умолчанию" : "Reset Defaults";
                        font-size: 12px;
                        color: Theme.text_muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    rst_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.reset_defaults(); }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;

                    // Close Button
                    Rectangle {
                        width: 90px;
                        height: 32px;
                        y: 10px;
                        border-radius: 4px;
                        background: cancel_touch.has-hover ? Theme.bg_surface2 : Theme.bg_surface1;
                        border-width: 1px;
                        border-color: Theme.border_normal;

                        Text {
                            text: root.current_language == "ru" ? "Закрыть" : "Close";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text_primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close_dialog(); }
                        }
                    }

                    // Save Button
                    Rectangle {
                        width: 150px;
                        height: 32px;
                        y: 10px;
                        border-radius: 4px;
                        background: save_touch.has-hover ? Theme.accent_blue : Theme.accent_green;

                        Text {
                            text: root.current_language == "ru" ? "Сохранить" : "Save Settings";
                            font-size: 13px;
                            font-weight: 700;
                            color: #151518;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        save_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.save_settings(); }
                        }
                    }
                }
            }
        }
    }
}
