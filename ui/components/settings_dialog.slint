import { Theme } from "theme.slint";
import { EditorSettingsTab } from "settings/editor_tab.slint";
import { AppearanceSettingsTab } from "settings/appearance_tab.slint";
import { LargeFilesSettingsTab } from "settings/large_files_tab.slint";
import { ToolchainSettingsTab } from "settings/toolchain_tab.slint";

export component SettingsDialog inherits Rectangle {
    in property <string> current_language: "ru";
    in-out property <int> active_tab: 0; // 0 = Editor, 1 = Appearance, 2 = Large Files, 3 = Toolchain

    // Editor settings
    in-out property <length> editor_font_size: 18px;
    in-out property <bool> editor_font_italic: false;
    in-out property <bool> cursor_blink: true;
    in-out property <int> tab_size: 4;

    // Appearance
    in-out property <int> active_theme_id: 1;
    in-out property <string> selected_language: "ru";

    // Large files
    in-out property <bool> large_file_optimizations: true;
    in-out property <int> soft_limit_mb: 20;
    in-out property <int> soft_limit_lines: 1000;
    in-out property <int> hard_limit_mb: 500;

    // Toolchain
    in-out property <int> toolchain_type: 0;
    in-out property <string> compiler_path: "";
    in-out property <string> compiler_args: "";
    in-out property <string> emulator_path: "";
    in-out property <string> emulator_args: "";

    // File association
    in-out property <bool> associate_asm_files: false;

    callback close_dialog();
    callback save_settings();
    callback reset_defaults();
    callback browse_compiler();
    callback browse_emulator();
    callback toggle_associate_asm();
    callback language_selected(string);
    callback theme_selected(int);

    width: 780px;
    height: 520px;
    background: Theme.menu_bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.menu_border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000cc;
    z: 250;

    // Absorb clicks on dialog background so they never pass to modal backdrop
    TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Modal Header
        Rectangle {
            height: 48px;
            background: Theme.header_bg;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border_normal;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/settings.svg");
                            width: 18px;
                            height: 18px;
                        }
                    }
                    Text {
                        text: root.current_language == "ru" ? "Настройки IDE" : "IDE Settings";
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.accent_yellow;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: 10px;
                    border-radius: 14px;
                    background: close_touch.has-hover ? Theme.bg_surface2 : #00000000;

                    Image {
                        source: @image-url("../icons/close.svg");
                        width: 12px;
                        height: 12px;
                        x: 8px;
                        y: 8px;
                    }

                    close_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close_dialog(); }
                    }
                }
            }
        }

        // Body: Left Category Tabs + Right Settings Pane
        HorizontalLayout {
            vertical-stretch: 1;

            Rectangle {
                width: 200px;
                background: Theme.sidebar_bg;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: Theme.border_normal;
                }

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    alignment: start;

                    Rectangle {
                        height: 36px;
                        border-radius: 4px;
                        background: root.active_tab == 0 ? Theme.bg_surface1 : (t0_touch.has-hover ? Theme.menu_hover : #00000000);
                        t0_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 0; } }
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Image { source: @image-url("../icons/editor.svg"); width: 15px; height: 15px; } }
                            Text {
                                text: root.current_language == "ru" ? "Редактор кода" : "Editor";
                                font-size: 13px;
                                font-weight: root.active_tab == 0 ? 700 : 500;
                                color: root.active_tab == 0 ? Theme.accent_blue : Theme.text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        border-radius: 4px;
                        background: root.active_tab == 1 ? Theme.bg_surface1 : (t1_touch.has-hover ? Theme.menu_hover : #00000000);
                        t1_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 1; } }
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Image { source: @image-url("../icons/palette.svg"); width: 15px; height: 15px; } }
                            Text {
                                text: root.current_language == "ru" ? "Внешний вид" : "Appearance";
                                font-size: 13px;
                                font-weight: root.active_tab == 1 ? 700 : 500;
                                color: root.active_tab == 1 ? Theme.accent_blue : Theme.text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        border-radius: 4px;
                        background: root.active_tab == 2 ? Theme.bg_surface1 : (t2_touch.has-hover ? Theme.menu_hover : #00000000);
                        t2_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 2; } }
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Image { source: @image-url("../icons/document.svg"); width: 15px; height: 15px; } }
                            Text {
                                text: root.current_language == "ru" ? "Большие файлы" : "Large Files";
                                font-size: 13px;
                                font-weight: root.active_tab == 2 ? 700 : 500;
                                color: root.active_tab == 2 ? Theme.accent_blue : Theme.text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        border-radius: 4px;
                        background: root.active_tab == 3 ? Theme.bg_surface1 : (t3_touch.has-hover ? Theme.menu_hover : #00000000);
                        t3_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 3; } }
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Image { source: @image-url("../icons/build.svg"); width: 15px; height: 15px; } }
                            Text {
                                text: root.current_language == "ru" ? "Тулчейн (Сборка)" : "Toolchain";
                                font-size: 13px;
                                font-weight: root.active_tab == 3 ? 700 : 500;
                                color: root.active_tab == 3 ? Theme.accent_blue : Theme.text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            Rectangle {
                background: Theme.editor_bg;
                clip: true;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    alignment: start;

                    if root.active_tab == 0: EditorSettingsTab {
                        current_language: root.current_language;
                        editor_font_size <=> root.editor_font_size;
                        editor_font_italic <=> root.editor_font_italic;
                        cursor_blink <=> root.cursor_blink;
                        tab_size <=> root.tab_size;
                        associate_asm_files <=> root.associate_asm_files;
                        toggle_associate_asm => { root.toggle_associate_asm(); }
                    }

                    if root.active_tab == 1: AppearanceSettingsTab {
                        current_language: root.current_language;
                        active_theme_id <=> root.active_theme_id;
                        selected_language <=> root.selected_language;
                        language_selected(lang) => { root.language_selected(lang); }
                        theme_selected(id) => { root.theme_selected(id); }
                    }

                    if root.active_tab == 2: LargeFilesSettingsTab {
                        current_language: root.current_language;
                        large_file_optimizations <=> root.large_file_optimizations;
                        soft_limit_mb <=> root.soft_limit_mb;
                        hard_limit_mb <=> root.hard_limit_mb;
                    }

                    if root.active_tab == 3: ToolchainSettingsTab {
                        current_language: root.current_language;
                        toolchain_type <=> root.toolchain_type;
                        compiler_path <=> root.compiler_path;
                        compiler_args <=> root.compiler_args;
                        emulator_path <=> root.emulator_path;
                        emulator_args <=> root.emulator_args;
                        browse_compiler => { root.browse_compiler(); }
                        browse_emulator => { root.browse_emulator(); }
                    }
                }
            }
        }

        // Modal Action Footer Bar
        Rectangle {
            height: 52px;
            background: Theme.header_bg;
            border-bottom-left-radius: 8px;
            border-bottom-right-radius: 8px;

            Rectangle {
                y: 0px;
                width: 100%;
                height: 1px;
                background: Theme.border_normal;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                Rectangle {
                    width: 160px;
                    height: 32px;
                    y: 10px;
                    border-radius: 4px;
                    background: rst_touch.has-hover ? Theme.bg_surface2 : #00000000;
                    border-width: 1px;
                    border-color: Theme.border_normal;

                    Text {
                        text: root.current_language == "ru" ? "Сбросить по умолчанию" : "Reset Defaults";
                        font-size: 12px;
                        color: Theme.text_muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    rst_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.reset_defaults(); }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        width: 90px;
                        height: 32px;
                        y: 10px;
                        border-radius: 4px;
                        background: cancel_touch.has-hover ? Theme.bg_surface2 : Theme.bg_surface1;
                        border-width: 1px;
                        border-color: Theme.border_normal;

                        Text {
                            text: root.current_language == "ru" ? "Закрыть" : "Close";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text_primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close_dialog(); }
                        }
                    }

                    Rectangle {
                        width: 150px;
                        height: 32px;
                        y: 10px;
                        border-radius: 4px;
                        background: save_touch.has-hover ? Theme.accent_blue : Theme.accent_green;

                        Text {
                            text: root.current_language == "ru" ? "Сохранить" : "Save Settings";
                            font-size: 13px;
                            font-weight: 700;
                            color: #151518;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        save_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.save_settings(); }
                        }
                    }
                }
            }
        }
    }
}
