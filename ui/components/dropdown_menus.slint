import { Theme } from "theme.slint";

export component FileDropdownMenu inherits Rectangle {
    in property <string> current_language: "ru";

    callback new_file();
    callback open_file();
    callback open_folder();
    callback save_file();
    callback save_file_as();
    callback refresh_files();
    callback open_settings();

    width: 320px;
    height: file_menu_layout.preferred-height;
    background: Theme.menu_bg;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.menu_border;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000088;
    z: 100;

    file_menu_layout := VerticalLayout {
        padding: 6px;
        spacing: 2px;

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: item_1.has-hover ? Theme.menu_hover : #00000000;
            item_1 := TouchArea { clicked => { root.new_file(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/plus.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Новый файл..." : "New File...";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: item_2.has-hover ? Theme.menu_hover : #00000000;
            item_2 := TouchArea { clicked => { root.open_file(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/folder-open.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Открыть файл... (Ctrl+O)" : "Open File... (Ctrl+O)";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: item_3.has-hover ? Theme.menu_hover : #00000000;
            item_3 := TouchArea { clicked => { root.open_folder(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/folder.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Открыть папку..." : "Open Folder...";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border_normal; }

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: item_4.has-hover ? Theme.menu_hover : #00000000;
            item_4 := TouchArea { clicked => { root.save_file(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/save.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Сохранить (Ctrl+S)" : "Save (Ctrl+S)";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: item_save_as.has-hover ? Theme.menu_hover : #00000000;
            item_save_as := TouchArea { clicked => { root.save_file_as(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/save.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Сохранить как... (Ctrl+Shift+S)" : "Save As... (Ctrl+Shift+S)";
                    font-size: 13px;
                    color: Theme.accent_blue;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: item_5.has-hover ? Theme.menu_hover : #00000000;
            item_5 := TouchArea { clicked => { root.refresh_files(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/refresh.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Обновить проводник" : "Refresh Explorer";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border_normal; }

        // Settings Modal Item
        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: item_settings.has-hover ? Theme.menu_hover : #00000000;
            item_settings := TouchArea { clicked => { root.open_settings(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/settings.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Настройки... (Ctrl+,)" : "Settings... (Ctrl+,)";
                    font-size: 13px;
                    color: Theme.accent_yellow;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component RunDropdownMenu inherits Rectangle {
    in property <string> current_language: "ru";

    callback run_emulator();
    callback run_assemble_only();
    callback run_syntax_check();

    width: 310px;
    height: run_menu_layout.preferred-height;
    background: Theme.menu_bg;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.menu_border;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000088;
    z: 100;

    run_menu_layout := VerticalLayout {
        padding: 6px;
        spacing: 2px;

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: r_item_1.has-hover ? Theme.menu_hover : #00000000;
            r_item_1 := TouchArea { clicked => { root.run_emulator(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/run.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Запуск в эмуляторе CP/M (F5)" : "Run in CP/M Emulator (F5)";
                    font-size: 13px;
                    color: #a6e3a1;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: r_item_2.has-hover ? Theme.menu_hover : #00000000;
            r_item_2 := TouchArea { clicked => { root.run_assemble_only(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/build.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Собрать .COM" : "Assemble .COM";
                    font-size: 13px;
                    color: #89b4fa;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: r_item_3.has-hover ? Theme.menu_hover : #00000000;
            r_item_3 := TouchArea { clicked => { root.run_syntax_check(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/check.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Проверить синтаксис 8080" : "Validate 8080 Syntax";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component ViewDropdownMenu inherits Rectangle {
    in property <string> current_language: "ru";
    in property <length> editor_font_size: 18px;
    in property <int> active_theme_id: 1;
    in-out property <bool> theme_submenu_expanded: false;

    callback zoom_in();
    callback zoom_out();
    callback zoom_reset();
    callback toggle_language();
    callback switch_theme(int);

    width: 330px;
    height: view_menu_layout.preferred-height;
    background: Theme.menu_bg;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.menu_border;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000088;
    z: 100;

    in-out property <bool> theme_flyout_open: false;
    out property <bool> show_theme_flyout: root.theme_flyout_open || v_theme_row.has-hover || flyout_touch.has-hover;

    view_menu_layout := VerticalLayout {
        padding: 6px;
        spacing: 2px;

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: v_item_1.has-hover ? Theme.menu_hover : #00000000;
            v_item_1 := TouchArea {
                pointer-event(e) => { if e.kind == PointerEventKind.move { root.theme_flyout_open = false; } }
                clicked => { root.zoom_in(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/zoom_in.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Приблизить (Ctrl + / Колесо ↑)" : "Zoom In (Ctrl + / Wheel ↑)";
                    font-size: 13px;
                    color: Theme.accent_blue;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: v_item_2.has-hover ? Theme.menu_hover : #00000000;
            v_item_2 := TouchArea {
                pointer-event(e) => { if e.kind == PointerEventKind.move { root.theme_flyout_open = false; } }
                clicked => { root.zoom_out(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/zoom_out.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Отдалить (Ctrl - / Колесо ↓)" : "Zoom Out (Ctrl - / Wheel ↓)";
                    font-size: 13px;
                    color: Theme.accent_blue;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: v_item_3.has-hover ? Theme.menu_hover : #00000000;
            v_item_3 := TouchArea {
                pointer-event(e) => { if e.kind == PointerEventKind.move { root.theme_flyout_open = false; } }
                clicked => { root.zoom_reset(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/refresh.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru" ? "Сброс масштаба 100% (Ctrl 0)" : "Reset Zoom (Ctrl 0)";
                    font-size: 13px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border_normal; }

        // Font size row
        Rectangle {
            height: 34px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../icons/editor.svg"); width: 16px; height: 16px; }
                    }
                    Text {
                        text: (root.current_language == "ru" ? "Размер шрифта: " : "Font size: ") + (root.editor_font_size / 1px) + "px";
                        font-size: 13px;
                        color: Theme.text_muted;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 28px;
                        height: 26px;
                        border-radius: 3px;
                        background: Theme.bg_surface1;
                        Text { text: "-"; font-size: 16px; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.zoom_out(); } }
                    }
                    Rectangle {
                        width: 28px;
                        height: 26px;
                        border-radius: 3px;
                        background: Theme.bg_surface1;
                        Text { text: "+"; font-size: 16px; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.zoom_in(); } }
                    }
                }
            }
        }

        // Language toggle
        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: v_item_5.has-hover ? Theme.menu_hover : #00000000;
            v_item_5 := TouchArea {
                pointer-event(e) => { if e.kind == PointerEventKind.move { root.theme_flyout_open = false; } }
                clicked => { root.toggle_language(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/globe.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru"
                        ? "Язык: Русский (нажмите для EN)"
                        : "Language: English (click for RU)";
                    font-size: 13px;
                    color: Theme.accent_green;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border_normal; }

        // Color Theme row with cascading right flyout on hover (VS Code style)
        theme_row := Rectangle {
            height: 34px;
            border-radius: 4px;
            background: root.show_theme_flyout ? Theme.menu_hover : #00000000;
            v_theme_row := TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.move || e.kind == PointerEventKind.down {
                        root.theme_flyout_open = true;
                    }
                }
                clicked => { root.theme_flyout_open = !root.theme_flyout_open; }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../icons/palette.svg"); width: 16px; height: 16px; }
                    }
                    Text {
                        text: root.current_language == "ru" ? "Цветовая тема" : "Color Theme";
                        font-size: 13px;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/chevron_right.svg");
                        width: 14px;
                        height: 14px;
                    }
                }
            }
        }
    }

    // Cascading Flyout Submenu to the right on hover
    Rectangle {
        visible: root.show_theme_flyout;
        x: root.width - 6px;
        y: theme_row.y - 4px;
        width: 255px;
        height: flyout_col.preferred-height;
        background: Theme.menu_bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.menu_border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #000000aa;
        z: 120;

        flyout_touch := TouchArea { }

        flyout_col := VerticalLayout {
            padding: 6px;
            spacing: 2px;

            // Theme 1: Cyberpunk 2077 Red
            Rectangle {
                height: 32px;
                border-radius: 4px;
                background: v_theme_cp.has-hover ? Theme.menu_hover : (root.active_theme_id == 1 ? Theme.bg_surface1 : #00000000);
                v_theme_cp := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.theme_flyout_open = false;
                        root.switch_theme(1);
                    }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: #fd6d6d;
                            }
                        }
                        Text {
                            text: "Cyberpunk 2077 Red";
                            font-size: 13px;
                            color: root.active_theme_id == 1 ? Theme.accent_blue : Theme.text_primary;
                            vertical-alignment: center;
                        }
                    }
                    if root.active_theme_id == 1: Text {
                        text: "✓";
                        font-size: 14px;
                        color: Theme.accent_blue;
                        vertical-alignment: center;
                    }
                }
            }

            // Theme 0: Catppuccin Dark
            Rectangle {
                height: 32px;
                border-radius: 4px;
                background: v_theme_cat.has-hover ? Theme.menu_hover : (root.active_theme_id == 0 ? Theme.bg_surface1 : #00000000);
                v_theme_cat := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.theme_flyout_open = false;
                        root.switch_theme(0);
                    }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: #89b4fa;
                            }
                        }
                        Text {
                            text: "Catppuccin Dark";
                            font-size: 13px;
                            color: root.active_theme_id == 0 ? Theme.accent_blue : Theme.text_primary;
                            vertical-alignment: center;
                        }
                    }
                    if root.active_theme_id == 0: Text {
                        text: "✓";
                        font-size: 14px;
                        color: Theme.accent_blue;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component HelpDropdownMenu inherits Rectangle {
    in property <string> current_language: "ru";

    callback open_docs();

    width: 380px;
    height: help_menu_layout.preferred-height;
    background: Theme.menu_bg;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.menu_border;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000088;
    z: 100;

    help_menu_layout := VerticalLayout {
        padding: 6px;
        spacing: 2px;

        Rectangle {
            height: 34px;
            border-radius: 4px;
            background: h_item_1.has-hover ? Theme.menu_hover : #00000000;
            h_item_1 := TouchArea { clicked => { root.open_docs(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/book.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: root.current_language == "ru"
                        ? "Справочник команд 8080"
                        : "8080 Instructions Encyclopedia";
                    font-size: 13px;
                    color: Theme.accent_blue;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 34px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/info.svg"); width: 16px; height: 16px; }
                }
                Text {
                    text: (root.current_language == "ru" ? "Тулчейн: " : "Toolchain: ") + (root.current_language == "ru" ? "Встроенный pure-Rust / Внешний" : "Built-in pure-Rust / External");
                    font-size: 13px;
                    color: Theme.text_muted;
                    vertical-alignment: center;
                }
            }
        }
    }
}
